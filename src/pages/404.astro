---
import Layout from "../components/Layout.astro";
---

<Layout title="Not found - hairhairhair.hair">
  <section class="mx-auto max-w-7xl px-5 py-32 sm:px-8">
    <p class="text-xs font-black uppercase tracking-[.2em] text-orange">404 / Lost strand</p>
    <h1 class="mt-5 max-w-3xl font-display text-7xl leading-[.84] tracking-[-.09em] sm:text-9xl">
      This page
      <br />
      <span class="text-orange">unravelled.</span>
    </h1>
    <a
      href="/"
      class="action-primary focus-ring mt-10 inline-block rounded-full border-2 border-ink px-6 py-3 text-sm font-black uppercase tracking-[.1em]"
    >
      Back home
    </a>
  </section>
</Layout>
