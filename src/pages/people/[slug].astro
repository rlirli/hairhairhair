---
import Layout from "../../components/Layout.astro";
import ExpandableBio from "../../components/ExpandableBio.astro";
import NaturalProfile from "../../components/NaturalProfile.astro";
import { Image } from "astro:assets";
import { people, personPhotographs } from "../../data/people";
import { appearancesForPerson, hairstylesForPerson } from "../../data/people-relations";
import { buildPersonMedia } from "../../data/people-media";
import { naturalProfileForPerson } from "../../data/natural-profiles";

export function getStaticPaths() {
  return people.map((person) => ({ params: { slug: person.slug }, props: { person } }));
}
const { person } = Astro.props;
const appearances = appearancesForPerson(person.id).sort((a, b) => b.taken.value.localeCompare(a.taken.value));
const hairstyleRecords = hairstylesForPerson(person.id);
const media = buildPersonMedia(personPhotographs);
const hero = media.find((photo) => photo.id === person.heroImageId) ?? media[0];
const heroAppearance = appearances.find((appearance) => appearance.imageId === person.heroImageId);
const naturalProfile = naturalProfileForPerson(person.id);
const appearanceTitle = (event: string) => event.split(",")[0];
const formatAppearanceDate = (value: string) =>
  new Intl.DateTimeFormat("en-US", { month: "short", year: "numeric" }).format(new Date(`${value}T00:00:00`));
const facePosition = (photoId: string) =>
  photoId === "will-smith-2009" ? "70% 48%" : photoId === "will-smith-2011" ? "58% 43%" : "61% 43%";
---

<Layout
  title={`${person.name} — people — hairhairhair.hair`}
  description={person.description}
  image={hero ? hero.src.src : undefined}
>
  <article class="mx-auto max-w-7xl px-5 pb-20 pt-12 sm:px-8">
    <nav aria-label="Breadcrumb" class="text-sm font-bold uppercase tracking-[.12em]">
      <a class="focus-ring text-orange" href="/">
        Home
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <a class="focus-ring text-orange" href="/people/">
        People
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <span>{person.name}</span>
    </nav>
    <header class="mt-10 grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:items-start">
      <div>
        <p class="text-xs font-black uppercase tracking-[.18em] text-orange">Person record</p>
        <h1 class="mt-5 font-display text-7xl leading-[.84] tracking-[-.08em] sm:text-9xl">{person.name}</h1>
        <div class="mt-8">
          <p class="text-xs font-black uppercase tracking-[.14em] opacity-60">Mini bio</p>
          <ExpandableBio id={`person-${person.slug}-bio`} text={person.description} />
        </div>
        <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-sm">
          {person.sourceUrls.map((sourceUrl, index) => (
            <a
              class="focus-ring font-bold text-orange underline decoration-orange decoration-2 underline-offset-4"
              href={sourceUrl}
              target="_blank"
              rel="noreferrer"
            >
              {index === 0 ? "photo source" : "bio source"} ↗
            </a>
          ))}
        </div>
      </div>
      <div class="grid gap-7 md:grid-cols-[1.1fr_.9fr] lg:grid-cols-1 xl:grid-cols-[1.1fr_.9fr]">
        {hero && (
          <figure>
            <Image
              src={hero.src}
              widths={[400, 800, 1120]}
              sizes="(min-width: 1280px) 38vw, (min-width: 768px) 55vw, 100vw"
              format="webp"
              alt={hero.alt}
              class="aspect-[4/3] w-full rounded-[2rem] object-cover object-[60%_50%]"
            />
            {heroAppearance && (
              <figcaption class="mt-3 text-sm leading-6">
                <a
                  class="focus-ring font-bold text-orange underline decoration-orange decoration-2 underline-offset-4"
                  href={`/people/${person.slug}/appearances/${heroAppearance.id}/`}
                >
                  {heroAppearance.taken.value} · {heroAppearance.event} — photograph details ↓
                </a>
              </figcaption>
            )}
          </figure>
        )}
        {naturalProfile && <NaturalProfile profile={naturalProfile} />}
      </div>
    </header>
    <section class="mt-20" aria-labelledby="appearances-heading">
      <div class="flex items-end justify-between gap-5 border-b border-ink pb-3">
        <h2 id="appearances-heading" class="text-xs font-black uppercase tracking-[.18em] text-orange">
          Appearances
        </h2>
        <a
          class="focus-ring text-xs font-black uppercase tracking-[.14em] text-orange underline decoration-orange decoration-2 underline-offset-4"
          href={`/people/${person.slug}/appearances/`}
        >
          More <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="mt-7 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {appearances.slice(0, 4).map((appearance) => {
          const photo = media.find((item) => item.id === appearance.imageId);
          return photo ? (
            <a
              class="group focus-ring block"
              href={`/people/${person.slug}/appearances/${appearance.id}/`}
              aria-label={`${formatAppearanceDate(appearance.taken.value)}: ${appearanceTitle(appearance.event)}`}
            >
              <figure>
                <Image
                  src={photo.src}
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                  format="webp"
                  alt={photo.alt}
                  class="aspect-square w-full rounded-[1.5rem] object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                  style={`object-position: ${photo.id === "will-smith-2009" ? "70% 48%" : photo.id === "will-smith-2011" ? "58% 43%" : "61% 43%"}`}
                />
                <figcaption class="mt-4">
                  <p class="text-xs font-black uppercase tracking-[.14em] text-orange">
                    {formatAppearanceDate(appearance.taken.value)}
                  </p>
                  <h3 class="mt-2 font-display text-2xl leading-[.95] tracking-[-.03em]">
                    {appearanceTitle(appearance.event)}
                  </h3>
                  <span class="mt-2 inline-block text-xs font-bold uppercase tracking-[.12em] text-orange underline decoration-orange decoration-2 underline-offset-4">
                    Appearance record ↗
                  </span>
                </figcaption>
              </figure>
            </a>
          ) : null;
        })}
      </div>
    </section>
    <section class="mt-20" aria-labelledby="hairstyles-heading">
      <div class="flex items-end justify-between gap-5 border-b border-ink pb-3">
        <h2 id="hairstyles-heading" class="text-xs font-black uppercase tracking-[.18em] text-orange">
          Hairstyles worn
        </h2>
        <a
          class="focus-ring text-xs font-black uppercase tracking-[.14em] text-orange underline decoration-orange decoration-2 underline-offset-4"
          href={`/people/${person.slug}/hairstyles/`}
        >
          More <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="mt-7 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {hairstyleRecords.slice(0, 4).map(({ style, appearances: styleAppearances }) => {
          const appearance = styleAppearances[0];
          const photo = media.find((item) => item.id === appearance.imageId);
          return photo ? (
            <a class="group focus-ring block" href={`/people/${person.slug}/hairstyles/${style.slug}/`}>
              <figure>
                <Image
                  src={photo.src}
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                  format="webp"
                  loading="lazy"
                  alt={`${person.name} wearing ${style.name}`}
                  class="aspect-square w-full rounded-[1.5rem] object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                  style={`object-position: ${facePosition(photo.id)}`}
                />
                <figcaption class="mt-4">
                  <h3 class="font-display text-3xl leading-[.95] tracking-[-.04em]">{style.name}</h3>
                </figcaption>
              </figure>
            </a>
          ) : null;
        })}
      </div>
    </section>
  </article>
</Layout>
