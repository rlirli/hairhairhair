---
import Layout from '../../components/Layout.astro';
import HairstyleCard from '../../components/HairstyleCard.astro';
import StyleMedia from '../../components/StyleMedia.astro';
import { getImage } from 'astro:assets';
import { hairFamilies, hairTypes } from '../../data/hair-types';
import { hairstyles, sources, getExamplesForHairstyle } from '../../data/hairstyles';
import { guidanceFor, relatedHairstyles } from '../../data/hairstyle-relations';
import { kindLabels } from '../../data/hairstyle-relations';
import { getMedia } from '../../data/media';

export function getStaticPaths() { return hairstyles.map((style) => ({ params: { slug: style.slug }, props: { style } })); }
const { style } = Astro.props;
const examples = getExamplesForHairstyle(style.id);
const heroMedia = examples[0]?.imageId;
const variations = style.variations;
const related = relatedHairstyles(style.relatedStyleIds);
const familyLinks = hairFamilies.map((family) => ({ family, guidance: guidanceFor(style.id, family.family) })).filter((item): item is { family: typeof item.family; guidance: NonNullable<typeof item.guidance> } => Boolean(item.guidance));
const sourceIds = style.sourceIds ?? [];
const referencedSources = sources.filter((source) => sourceIds.includes(source.id));
const kindLabel = kindLabels[style.kind];
const ogImage = heroMedia ? (await getImage({ src: getMedia(heroMedia)!.src, width: 1120, format: 'jpg' })).src : undefined;
---
<Layout title={`${style.name} guide — hairhairhair.hair`} description={style.summary} image={ogImage}>
  <article class="mx-auto max-w-7xl px-5 pb-20 pt-12 sm:px-8">
    <nav aria-label="Breadcrumb" class="text-sm font-bold uppercase tracking-[.12em]"><a class="focus-ring text-orange" href="/">Home</a><span class="mx-2" aria-hidden="true">/</span><a class="focus-ring text-orange" href="/hairstyles/">Hairstyles</a><span class="mx-2" aria-hidden="true">/</span><span>{style.name}</span></nav>
    <div class="mt-10 grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-center"><div><p class="text-xs font-black uppercase tracking-[.18em]">{kindLabel}</p><h1 class="mt-5 font-display text-6xl leading-[.84] tracking-[-.08em] sm:text-8xl">{style.name}</h1>{style.intro.map((paragraph: string) => <p class="mt-6 max-w-xl text-lg leading-7">{paragraph}</p>)}</div><div>{heroMedia && <StyleMedia mediaId={heroMedia} title={examples[0]?.title} caption={examples[0]?.caption} patternDescription={examples[0]?.patternDescription} lengthDescription={examples[0]?.lengthDescription} eager />}</div></div>
    <section class="mt-16 border-t-2 border-ink pt-10"><div class="flex flex-col items-start justify-between gap-5 sm:flex-row sm:items-end"><div><p class="text-xs font-black uppercase tracking-[.18em] text-orange">Reference gallery</p><h2 class="mt-2 font-display text-4xl tracking-[-.06em]">Different ways it can read</h2></div><p class="max-w-xs text-sm leading-5 sm:text-right">Generated references show design details, not a real person or a diagnostic hair type.</p></div><div class="mt-7 grid gap-5 md:grid-cols-2">{examples.slice(0, 2).map((example) => <StyleMedia mediaId={example.imageId} title={example.title} caption={example.caption} patternDescription={example.patternDescription} lengthDescription={example.lengthDescription} />)}</div></section>
    <section class="mt-16 grid gap-10 border-t-2 border-ink pt-10 lg:grid-cols-[1fr_1fr]"><div><p class="text-xs font-black uppercase tracking-[.18em] text-orange">Variations</p><h2 class="mt-2 font-display text-4xl tracking-[-.06em]">Choose the details</h2><div class="mt-6 space-y-5">{variations.map((variation) => <div class="border-b border-ink/30 pb-4"><h3 class="font-display text-2xl">{variation.name}</h3><p class="mt-1 text-base leading-6">{variation.description}</p></div>)}</div></div><div class="inverse-panel rounded-[2rem] p-7"><p class="inverse-label text-xs font-black uppercase tracking-[.16em]">{style.consultation.intro}</p><ul class="mt-5 space-y-3 text-lg leading-8">{style.consultation.questions.map((question: string) => <li class="flex gap-3"><span aria-hidden="true">•</span><span>{question}</span></li>)}</ul><p class="mt-6 border-t border-current/30 pt-5 text-base leading-7">{style.consultation.sampleRequest}</p></div></section>
    <section class="mt-16 grid gap-10 border-t-2 border-ink pt-10 lg:grid-cols-[1fr_1fr]"><div><p class="text-xs font-black uppercase tracking-[.18em] text-orange">What changes the result</p><h2 class="mt-2 font-display text-4xl tracking-[-.06em]">Bring these variables</h2><ul class="mt-6 space-y-3">{style.considerations.map((item: string) => <li class="flex gap-3 text-base leading-6"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-orange"></span>{item}</li>)}</ul></div><div><p class="text-xs font-black uppercase tracking-[.18em] text-orange">Pattern guidance</p><h2 class="mt-2 font-display text-4xl tracking-[-.06em]">Explore by family</h2><div class="mt-6 space-y-4">{familyLinks.map(({ family, guidance }) => <div class="rounded-2xl border-2 border-ink p-4"><a class="focus-ring font-display text-2xl hover:text-orange" href={`/hair-types/${family.slug}/`}>Type {family.code} · {family.name}</a><p class="mt-2 text-sm leading-6">{guidance.note}</p><div class="mt-3 flex flex-wrap gap-2">{hairTypes.filter((type) => type.family === family.family).map((type) => <a class="focus-ring text-xs font-bold uppercase tracking-[.1em] text-orange underline" href={`/hair-types/${type.slug}/`}>{type.code}</a>)}</div></div>)}</div></div></section>
    {related.length > 0 && <section class="mt-16 border-t-2 border-ink pt-10"><p class="text-xs font-black uppercase tracking-[.18em] text-orange">Related guides</p><div class="mt-5 grid gap-4 md:grid-cols-3">{related.map((item) => <HairstyleCard style={item} compact />)}</div></section>}
    <section class="mt-16 border-t-2 border-ink pt-8"><p class="text-xs font-black uppercase tracking-[.18em] text-orange">Sources reviewed</p><div class="mt-4 space-y-2 text-sm leading-6">{referencedSources.map((source) => <p><a class="focus-ring underline decoration-orange decoration-2 underline-offset-4" href={source.url} target="_blank" rel="noreferrer">{source.title}</a> · {source.publisher} · reviewed {source.reviewedAt}</p>)}</div></section>
  </article>
</Layout>
