---
import Layout from "../../../components/Layout.astro";
import StyleMedia from "../../../components/StyleMedia.astro";
import { getExamplesForHairstyle, publishedHairstyles } from "../../../data/hairstyles";

export function getStaticPaths() {
  return publishedHairstyles.map((style) => ({ params: { slug: style.slug }, props: { style } }));
}

const { style } = Astro.props;
const examples = getExamplesForHairstyle(style.id);
---

<Layout title={`${style.name} examples — hairhairhair.hair`} description={`Visual references for ${style.name}.`}>
  <main class="mx-auto max-w-7xl px-5 pb-20 pt-12 sm:px-8">
    <nav aria-label="Breadcrumb" class="text-sm font-bold uppercase tracking-[.12em]">
      <a class="focus-ring text-orange" href="/hairstyles/">
        Hairstyles
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <a class="focus-ring text-orange" href={`/hairstyles/${style.slug}/`}>
        {style.name}
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <span>Examples</span>
    </nav>
    <h1 class="mt-10 font-display text-5xl tracking-[-.07em] sm:text-7xl">{style.name} examples</h1>
    <p class="mt-4 max-w-2xl text-lg leading-7">
      Different visual references for the same hairstyle idea. These are examples, not fixed specifications.
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {examples.map((example, index) => (
        <StyleMedia
          mediaId={example.imageId}
          title={example.title}
          caption={example.caption}
          patternDescription={example.patternDescription}
          lengthDescription={example.lengthDescription}
          eager={index === 0}
        />
      ))}
    </div>
  </main>
</Layout>
