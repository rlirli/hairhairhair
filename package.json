{
  "name": "hairhairhair",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "build:clean": "node scripts/clean-dist.mjs && astro build",
    "check": "npm run validate:content && astro check",
    "dev": "astro dev",
    "explore:relations": "vite --config exploration/vite.config.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "astro preview",
    "test": "npm run build:clean && npm run test:component && npm run test:content",
    "test:component": "vitest run --config vitest.config.ts",
    "test:content": "node --test tests/*.test.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "verify": "npm run format:check && npm run check && npm test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.6",
    "@base-ui/react": "^1.8.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "clsx": "^2.1.1",
    "d3-drag": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/d3-drag": "^3.0.7",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-multiline-arrays": "^4.1.11",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vitest": "^5.0.1"
  }
}
