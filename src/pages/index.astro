---
import Layout from "../components/Layout.astro";
import Pattern from "../components/Pattern.astro";
import { hairFamilies } from "../data/hair-types";
import HairstyleCard from "../components/HairstyleCard.astro";
import { hairstyles } from "../data/hairstyles";
import { people } from "../data/people";
---

<Layout>
  <section class="relative mx-auto grid max-w-7xl gap-10 overflow-hidden px-5 pb-20 pt-12 sm:px-8 lg:grid-cols-[1.1fr_.9fr] lg:items-end lg:pt-20">
    <div class="texture pointer-events-none absolute inset-0 -z-10"></div>
    <div>
      <p class="mb-7 text-xs font-black uppercase tracking-[.2em] text-orange">An illustrated field guide</p>
      <h1 class="max-w-4xl font-display text-[clamp(4.2rem,12vw,10.5rem)] leading-[.8] tracking-[-.09em]">
        Your hair,
        <br />
        <em class="text-orange">mapped.</em>
      </h1>
      <p class="mt-10 max-w-md text-lg leading-7">
        Hair is wonderfully specific. Browse a clear, visual language for the patterns, textures, and families that make
        it yours.
      </p>
      <a
        href="/hair-types/"
        class="action-primary focus-ring mt-8 inline-flex rounded-full border-2 border-ink px-6 py-3 text-sm font-black uppercase tracking-[.1em] transition"
      >
        <span>Explore hair types</span>{" "}
        <span class="ml-3" aria-hidden="true">
          ↗
        </span>
      </a>
    </div>
    <Pattern family="wavy" subtype="B" />
  </section>
  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8" id="about">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <p class="text-xs font-black uppercase tracking-[.2em] text-orange">Start here</p>
        <h2 class="mt-2 font-display text-5xl tracking-[-.06em]">The four families</h2>
      </div>
      <a
        href="/hair-types/"
        class="focus-ring text-sm font-bold underline decoration-orange decoration-2 underline-offset-4"
      >
        See all types →
      </a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {hairFamilies.map((family) => (
        <a
          href={`/hair-types/${family.slug}/`}
          class="hover-surface focus-ring group rounded-3xl border-2 border-ink bg-white/30 p-5 transition hover:-translate-y-1"
        >
          <p class="text-xs font-black uppercase tracking-[.16em] text-orange">Family {family.code}</p>
          <h3 class="mt-14 font-display text-3xl tracking-[-.05em] group-hover:underline">Type {family.code}</h3>
          <p class="mt-2 font-display text-xl">{family.name}</p>
          <p class="mt-2 text-sm leading-5">{family.description}</p>
        </a>
      ))}
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="text-xs font-black uppercase tracking-[.2em] text-orange">New collection</p>
        <h2 class="mt-2 font-display text-5xl tracking-[-.06em]">Hairstyle guides</h2>
        <p class="mt-4 max-w-xl text-lg leading-7">
          Find the words for a cut, finishing technique, or temporary style before your consultation.
        </p>
      </div>
      <a
        href="/hairstyles/"
        class="focus-ring text-sm font-bold underline decoration-orange decoration-2 underline-offset-4"
      >
        Browse all guides →
      </a>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {hairstyles.map((style) => (
        <HairstyleCard style={style} compact />
      ))}
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-5 pb-20 sm:px-8">
    <div class="rounded-[2rem] border-2 border-ink p-7 sm:p-10">
      <p class="text-xs font-black uppercase tracking-[.2em] text-orange">People and appearances</p>
      <h2 class="mt-3 font-display text-5xl tracking-[-.06em]">A look at the record.</h2>
      <p class="mt-4 max-w-2xl text-lg leading-7">
        Dated, source-attributed photographs show how a hairstyle reads at one moment without assigning a permanent hair
        type.
      </p>
      {people.map((person) => (
        <a
          href={`/people/${person.slug}/`}
          class="focus-ring mt-6 inline-block rounded-full border-2 border-ink px-5 py-3 text-sm font-black uppercase tracking-[.1em] hover-surface"
        >
          Explore {person.name} ↗
        </a>
      ))}
    </div>
  </section>
</Layout>
