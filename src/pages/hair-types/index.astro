---
import Layout from "../../components/Layout.astro";
import HairStrand from "../../components/HairStrand.astro";
import { hairSubtypes, hairTypes } from "../../data/hair-types";

const subtypesFor = (typeId: string) => hairSubtypes.filter((subtype) => subtype.hairTypeId === typeId);
---

<Layout
  title="Hair types - hairhairhair.hair"
  description="A quick visual introduction to the four hair types and their 12 sub-types."
>
  <section class="mx-auto max-w-7xl px-5 pb-14 pt-14 sm:px-8 sm:pt-16">
    <p class="text-xs font-black uppercase tracking-[.2em] text-orange">The hair chart</p>
    <h1 class="mt-3 max-w-4xl font-display text-6xl leading-[.86] tracking-[-.08em] sm:text-8xl">
      Identify your Hair Type
    </h1>
    <p class="mt-7 max-w-3xl text-base leading-7 sm:text-lg sm:leading-8">
      The Andre Walker Hair Typing System groups natural hair by the visible shape of its pattern. We use this shared
      vocabulary to help you find hairstyles and celebrity inspiration that more closely matches your natural hair. Each
      numbered type has three lettered subtypes - A, B, and C - which describe pattern variations within that type.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-20 sm:px-8" aria-labelledby="comparison-heading">
    <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-black uppercase tracking-[.2em] text-orange">Compare by shape</p>
        <h2 id="comparison-heading" class="mt-2 font-display text-4xl tracking-[-.06em] sm:text-5xl">
          All four types, at a glance
        </h2>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
      {hairTypes.map((hairType) => (
        <section class="type-group rounded-[2rem] border-2 border-ink p-3 sm:p-4" data-type={hairType.code}>
          <a href={`/hair-types/${hairType.slug}/`} class="focus-ring group block rounded-[1.35rem] px-2 py-2">
            <span class="type-accent block text-xs font-black uppercase tracking-[.16em]">Type {hairType.code}</span>
            <h3 class="mt-1 font-display text-3xl tracking-[-.06em] group-hover:underline">{hairType.name}</h3>
          </a>

          <div class="mt-2 grid grid-cols-3 gap-2" aria-label={`Type ${hairType.code} hair shapes`}>
            {subtypesFor(hairType.id).map((subtype) => (
              <a
                href={`/hair-types/${subtype.slug}/`}
                class="hover-surface focus-ring group rounded-2xl p-1.5 transition sm:p-2"
                aria-label={`${subtype.code}: ${subtype.name}`}
              >
                <HairStrand code={subtype.code} decorative />
                <span class="mt-2 block text-center font-display text-xl leading-none group-hover:underline">
                  {subtype.code}
                </span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    <div class="grid grid-cols-2 gap-x-3 gap-y-6 md:grid-cols-4 md:gap-x-4">
      {hairTypes.map((hairType) => (
        <div
          class="type-column row-span-2 grid grid-rows-subgrid rounded-2xl gap-1"
          data-type={hairType.code}
          aria-labelledby={`type-${hairType.code}-heading`}
        >
          <a
            href={`/hair-types/${hairType.slug}/`}
            class="type-main focus-ring block rounded-2xl border-2 border-ink p-3 transition hover:-translate-y-0.5 sm:p-4"
          >
            <span class="type-accent block text-xs font-black uppercase tracking-[.16em]">Type {hairType.code}</span>

            <h3 id={`type-${hairType.code}-heading`} class="mt-1 font-display text-2xl tracking-[-.05em] sm:text-3xl">
              {hairType.name}
            </h3>

            <p class="mt-2 text-xs leading-4">{hairType.description}</p>
          </a>

          <div
            class="grid gap-x-2 gap-y-1 px-2 pt-2 pb-3 sm:gap-x-3 sm:gap-y-2"
            aria-label={`Type ${hairType.code} sub-types`}
          >
            {subtypesFor(hairType.id).map((subtype) => (
              <a
                href={`/hair-types/${subtype.slug}/`}
                class="hover-surface focus-ring group block rounded-xl border border-transparent px-2.5 py-1.5 transition hover:border-ink/35 focus-visible:border-ink/35 sm:px-3 sm:py-2.5"
              >
                <span class="block font-display text-xl leading-none group-hover:underline">{subtype.code}</span>

                <span class="mt-1 block text-xs leading-4">{subtype.name}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .type-group[data-type="1"],
  .type-column[data-type="1"] {
    --type-accent: #8d877f;
    background: rgba(255, 255, 255, 0.34);
  }

  .type-group[data-type="2"],
  .type-column[data-type="2"] {
    --type-accent: #657c2d;
    background: rgba(170, 183, 160, 0.22);
  }

  .type-group[data-type="3"],
  .type-column[data-type="3"] {
    --type-accent: #c51f68;
    background: rgba(248, 218, 229, 0.34);
  }

  .type-group[data-type="4"],
  .type-column[data-type="4"] {
    --type-accent: #a30e58;
    background: rgba(239, 218, 228, 0.34);
  }

  .type-accent {
    color: var(--type-accent, var(--color-orange));
  }

  .type-main {
    background: color-mix(in srgb, var(--type-accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--type-accent) 55%, transparent);
  }

  :global(.dark) .type-group,
  :global(.dark) .type-column {
    background: rgba(255, 255, 255, 0.07);
  }
</style>
