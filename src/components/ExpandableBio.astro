---
interface Props {
  id: string;
  text: string;
}

const { id, text } = Astro.props;
---

<div data-expandable-bio class="max-w-xl" data-expanded="false">
  <p id={id} data-bio-text class="leading-7">
    {text}
  </p>
  <button
    type="button"
    data-bio-toggle
    class="focus-ring mt-2 text-sm font-black uppercase tracking-[.12em] text-orange underline decoration-orange decoration-2 underline-offset-4"
    aria-controls={id}
    aria-expanded="false"
    hidden
  >
    More
  </button>
</div>

<script>
  const setupExpandableBios = () => {
    document.querySelectorAll<HTMLElement>("[data-expandable-bio]").forEach((root) => {
      if (root.dataset.ready === "true") return;
      root.dataset.ready = "true";
      const text = root.querySelector<HTMLElement>("[data-bio-text]");
      const toggle = root.querySelector<HTMLButtonElement>("[data-bio-toggle]");
      if (!text || !toggle) return;

      const sync = () => {
        const expanded = root.dataset.expanded === "true";
        text.classList.remove("bio-text--collapsed");
        text.style.maxHeight = "none";
        text.style.overflow = "visible";
        const fullHeight = text.scrollHeight;
        text.classList.add("bio-text--collapsed");
        const collapsedHeight = text.clientHeight;
        const overflows = fullHeight > collapsedHeight + 1;
        if (expanded || !overflows) text.classList.remove("bio-text--collapsed");
        text.style.overflow = expanded || !overflows ? "visible" : "hidden";
        toggle.hidden = !overflows;
        toggle.setAttribute("aria-expanded", String(expanded));
        toggle.textContent = expanded ? "Less" : "More";
      };

      toggle.addEventListener("click", () => {
        root.dataset.expanded = root.dataset.expanded !== "true" ? "true" : "false";
        sync();
      });
      sync();
      window.addEventListener("resize", sync);
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupExpandableBios, { once: true });
  } else {
    setupExpandableBios();
  }
</script>

<style>
  [data-bio-text].bio-text--collapsed {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
</style>
