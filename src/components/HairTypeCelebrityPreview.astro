---
import { Image } from "astro:assets";
import NaturalProfile from "./NaturalProfile.astro";
import { peopleForHairTypeSlug } from "../data/hair-type-discovery";

const { slug } = Astro.props as { slug: string };
const people = peopleForHairTypeSlug(slug);
---

{people.length > 0 && (
  <section class="mx-auto max-w-7xl px-5 pb-16 sm:px-8" aria-label="People with this natural hair type">
    <div class="flex items-baseline justify-between gap-4 border-t border-ink/30 pt-5">
      <h2 class="text-xs font-black uppercase tracking-[.16em] text-orange">People with this hair type</h2>
      <a
        class="focus-ring text-xs font-black uppercase tracking-[.12em] text-orange hover:underline"
        href={`/hair-types/${slug}/people/`}
      >
        More →
      </a>
    </div>
    <div class="mt-4 grid grid-flow-col auto-cols-[minmax(8rem,1fr)] gap-3 overflow-x-auto pb-3 lg:grid-flow-row lg:grid-cols-7 lg:auto-cols-auto lg:overflow-visible">
      {people.map(({ person, photo, naturalProfile, subtype }) => (
        <div class="group relative">
          <a class="focus-ring block" href={`/people/${person.slug}/`}>
            <Image
              src={photo.src}
              alt={photo.alt}
              width={180}
              height={180}
              class="aspect-square w-full rounded-2xl object-cover"
            />
            <span class="mt-2 block font-bold leading-tight">{person.name}</span>
            {subtype && <span class="mt-1 block text-xs opacity-65">Type {subtype.code}</span>}
          </a>
          <span class="pointer-events-none absolute bottom-14 left-0 z-20 hidden w-72 rounded-2xl bg-paper p-3 shadow-xl group-hover:block group-focus-within:block">
            <NaturalProfile profile={naturalProfile} />
          </span>
        </div>
      ))}
    </div>
  </section>
)}
