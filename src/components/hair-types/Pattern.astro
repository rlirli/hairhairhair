---
import { Image } from "astro:assets";
import straightTexture from "../../assets/hair-types/type-1-straight.png";
import wavyTexture from "../../assets/hair-types/type-2-wavy.png";
import curlyTexture from "../../assets/hair-types/type-3-curly.png";
import coilyTexture from "../../assets/hair-types/type-4-coily.png";

interface Props {
  pattern?: "straight" | "wavy" | "curly" | "coily";
  subtype?: "A" | "B" | "C";
  label?: string;
  caption?: string | false;
}

const { pattern = "wavy", subtype = "B", label, caption } = Astro.props;
const typeCodeByPattern = { straight: "1", wavy: "2", curly: "3", coily: "4" } as const;
const textureByPattern = {
  straight: straightTexture,
  wavy: wavyTexture,
  curly: curlyTexture,
  coily: coilyTexture,
};
const typeCode = typeCodeByPattern[pattern];
const accessibleLabel =
  label ?? `Illustrative close-up of natural ${pattern} hair texture, Type ${typeCode}. Not a diagnostic.`;
---

<div class="texture-panel overflow-hidden rounded-2xl border border-ink/10 bg-white/30 p-2">
  <Image
    src={textureByPattern[pattern]}
    alt={accessibleLabel}
    class="block aspect-[5/3] w-full rounded-xl object-cover"
    widths={[320, 640]}
    sizes="(min-width: 768px) 320px, 100vw"
  />
  {caption !== false && (
    <span class="block px-2 pb-1 pt-2 text-[10px] font-bold uppercase tracking-[.1em]">
      {caption ?? `Type ${typeCode}${subtype} · ${pattern} texture`}
    </span>
  )}
</div>
