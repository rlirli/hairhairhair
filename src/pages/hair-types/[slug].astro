---
import Layout from '../../components/Layout.astro';
import Pattern from '../../components/Pattern.astro';
import { hairTypes } from '../../data/hair-types';
export function getStaticPaths() { return hairTypes.map((hairType) => ({ params: { slug: hairType.slug }, props: { hairType } })); }
const { hairType } = Astro.props;
const currentIndex = hairTypes.findIndex((item) => item.slug === hairType.slug);
const previous = currentIndex > 0 ? hairTypes[currentIndex - 1] : undefined;
const next = currentIndex < hairTypes.length - 1 ? hairTypes[currentIndex + 1] : undefined;
---
<Layout title={`Type ${hairType.code}: ${hairType.name} — hairhairhair.hair`} description={hairType.description}>
  <article class="mx-auto max-w-7xl px-5 pb-20 pt-12 sm:px-8"><a class="focus-ring text-sm font-bold uppercase tracking-[.12em] text-orange" href="/hair-types/">← All hair types</a><div class="mt-10 grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-center"><div><p class="text-xs font-black uppercase tracking-[.18em]">{hairType.family} · {hairType.code}</p><h1 class="mt-5 font-display text-7xl leading-[.82] tracking-[-.09em] sm:text-9xl">Type {hairType.code}</h1><p class="mt-5 font-display text-3xl leading-tight tracking-[-.04em]">{hairType.name}</p><p class="mt-7 max-w-xl text-xl leading-8">{hairType.description}</p></div><Pattern family={hairType.family} subtype={hairType.subtype} /></div><p class="mt-8 max-w-2xl border-l-4 border-orange pl-4 text-sm leading-6">Pattern is one part of the picture. You may have more than one pattern on the same head. Thickness, density, porosity, and care history can change how any type looks and behaves.</p><div class="mt-14 grid gap-5 border-t-2 border-ink pt-8 md:grid-cols-2"><section><h2 class="font-display text-3xl tracking-[-.05em]">What to notice</h2><ul class="mt-5 space-y-3">{hairType.characteristics.map((item) => <li class="flex gap-3 text-base leading-6"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-orange"></span>{item}</li>)}</ul></section><section class="rounded-3xl bg-ink p-7 text-ivory"><p class="text-xs font-black uppercase tracking-[.16em] text-butter">A useful comparison</p><p class="mt-5 text-lg leading-7">{hairType.comparison}</p></section></div><nav class="mt-16 grid grid-cols-2 gap-4 border-t-2 border-ink pt-6" aria-label="Adjacent hair types">{previous ? <a class="focus-ring rounded-2xl border-2 border-ink p-4 hover:bg-butter" href={`/hair-types/${previous.slug}/`}><span class="block text-xs font-bold uppercase tracking-[.12em] text-orange">Previous</span><span class="mt-2 block font-display text-2xl">{previous.name}</span></a> : <span></span>}{next ? <a class="focus-ring rounded-2xl border-2 border-ink p-4 text-right hover:bg-butter" href={`/hair-types/${next.slug}/`}><span class="block text-xs font-bold uppercase tracking-[.12em] text-orange">Next</span><span class="mt-2 block font-display text-2xl">{next.name}</span></a> : <span></span>}</nav></article>
</Layout>
