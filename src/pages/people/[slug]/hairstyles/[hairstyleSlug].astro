---
import { Image } from "astro:assets";
import Layout from "../../../../components/shared/Layout.astro";
import {
  getAppearancesForPersonAndHairstyle,
  getHairstyleAppearancesForPerson,
  getRepresentativeHairstyleMedia,
} from "../../../../data";
import { getHairstyleBySlug } from "../../../../data";
import { people, personPhotographs } from "../../../../data/people";
import PhotoAttribution from "../../../../components/shared/PhotoAttribution";
import { appearanceTitle, formatAppearanceDate } from "../../../../lib/appearance-formatting";

export function getStaticPaths() {
  return people.flatMap((person) =>
    getHairstyleAppearancesForPerson(person.id).map(({ style }) => ({
      params: { slug: person.slug, hairstyleSlug: style.slug },
      props: { person, style },
    })),
  );
}

const { person, style: pathStyle } = Astro.props;
const style = pathStyle ?? getHairstyleBySlug(Astro.params.hairstyleSlug ?? "");
if (!style) throw new Error(`Unknown hairstyle: ${Astro.params.hairstyleSlug}`);
const media = personPhotographs;
const records = getAppearancesForPersonAndHairstyle(person.id, style.id);
const recordsWithPhotos = records.filter(
  (appearance) => appearance.imageId && media.some((photo) => photo.id === appearance.imageId),
);
const displayedRecords = recordsWithPhotos.length ? recordsWithPhotos : records;
---

<Layout
  title={`${person.name} wearing ${style.name}`}
  description={`Documented appearances where ${person.name} wore ${style.name}.`}
>
  <article class="mx-auto max-w-7xl px-5 pb-20 pt-12 sm:px-8">
    <nav
      aria-label="Breadcrumb"
      class="mb-8 flex flex-wrap items-center gap-y-1 text-xs font-bold uppercase tracking-[.12em] sm:text-sm"
    >
      <a class="focus-ring text-orange" href="/">
        Home
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <a class="focus-ring text-orange" href="/people/">
        People
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <a class="focus-ring text-orange" href={`/people/${person.slug}/`}>
        {person.name}
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <a class="focus-ring text-orange" href={`/people/${person.slug}/hairstyles/`}>
        Hairstyles
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <span>{style.name}</span>
    </nav>

    <header class="mt-12">
      <h1 class="mt-4 font-display text-6xl leading-[.88] tracking-[-.08em] sm:text-8xl">
        <a class="focus-ring hover:underline" href={`/people/${person.slug}/`}>
          {person.name}
        </a>{" "}
        wearing{" "}
        <a class="focus-ring hover:underline" href={`/hairstyles/${style.slug}/`}>
          {style.name}
        </a>
      </h1>
      <p class="mt-6 text-lg leading-7">
        {person.name} wearing this hairstyle in {displayedRecords.length} documented{" "}
        {displayedRecords.length === 1 ? "appearance" : "appearances"}.
      </p>
    </header>

    <section class="mt-16" aria-labelledby="appearances-heading">
      <div class="border-b border-taupe pb-3 sm:pb-2">
        <p class="text-xs font-black uppercase tracking-[.18em] text-orange">Appearance archive</p>
        <h2 id="appearances-heading" class="mt-2 font-display text-4xl tracking-[-.06em]">
          All documented appearances
        </h2>
      </div>

      <ul class="mt-2.5 sm:mt-4 grid grid-cols-2 gap-x-4 gap-y-6 lg:grid-cols-4">
        {displayedRecords.map((appearance) => {
          const photo = appearance.imageId ? media.find((item) => item.id === appearance.imageId) : undefined;
          const observation = appearance.observations.find((item) => item.hairstyleId === style.id);
          const example = getRepresentativeHairstyleMedia(style.id, observation?.styleExampleId);
          const image = photo ?? example?.media;
          return image ? (
            <li class="group">
              <figure class="relative overflow-hidden">
                <a
                  class="focus-ring block"
                  href={photo ? `/people/${person.slug}/photographs/${photo.id}/` : appearance.taken.sourceUrl}
                  target={photo ? undefined : "_blank"}
                  rel={photo ? undefined : "noreferrer"}
                  aria-label={photo ? undefined : `Open source for ${appearance.event}`}
                >
                  <Image
                    src={image.image}
                    widths={[400, 700, 1000]}
                    sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                    format="webp"
                    loading="lazy"
                    alt={image.alt}
                    class="aspect-[7/9] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                  />
                </a>
                {photo ? (
                  <PhotoAttribution provenance={photo.provenance} density="compact" />
                ) : (
                  <span class="absolute inset-x-0 bottom-0 bg-black/70 px-2 py-1.5 text-[.65rem] font-bold uppercase tracking-[.1em] text-white">
                    Hairstyle example · no source photo archived
                  </span>
                )}
              </figure>
              <div class="mt-2">
                <h3 class="font-display text-lg leading-tight tracking-[-.02em]">
                  {photo ? (
                    <a class="focus-ring" href={`/people/${person.slug}/appearances/${appearance.id}/`}>
                      {appearanceTitle(appearance.event)}
                    </a>
                  ) : (
                    <a class="focus-ring" href={appearance.taken.sourceUrl} target="_blank" rel="noreferrer">
                      {appearanceTitle(appearance.event)}
                    </a>
                  )}
                </h3>
                <p class="mt-1 text-xs leading-tight text-muted">{formatAppearanceDate(appearance.taken.value)}</p>
                {observation && <p class="mt-2 text-sm leading-5">{observation.note}</p>}
              </div>
            </li>
          ) : null;
        })}
      </ul>
    </section>

    <nav aria-label="Related pages" class="mt-14 flex flex-wrap gap-x-6 gap-y-2 font-bold text-orange">
      <a
        class="focus-ring underline decoration-orange decoration-2 underline-offset-4"
        href={`/people/${person.slug}/hairstyles/`}
      >
        All hairstyles worn by {person.name}
      </a>
      <a
        class="focus-ring underline decoration-orange decoration-2 underline-offset-4"
        href={`/people/${person.slug}/`}
      >
        {person.name}&apos;s profile
      </a>
      <a
        class="focus-ring underline decoration-orange decoration-2 underline-offset-4"
        href={`/hairstyles/${style.slug}/`}
      >
        {style.name}
      </a>
    </nav>
  </article>
</Layout>
