---
import Layout from "../../components/shared/Layout.astro";
import Pattern from "../../components/hair-types/Pattern.astro";
import HairstyleGridData from "../../components/hairstyles/HairstyleGridData.astro";
import CelebrityGrid from "../../components/people/CelebrityGrid.astro";
import HairTypeNavigator from "../../components/hair-types/HairTypeNavigator.astro";
import CollectionHeader from "../../components/shared/CollectionHeader.astro";
import { hairSubtypes, hairTypes } from "../../data/hair-types";
import { getPeopleForHairTypeSlug, getCompatibleHairstylesForHairTypeSlug } from "../../data/hair-type-discovery";

export function getStaticPaths() {
  return [
    ...hairTypes.map((hairType) => ({ params: { slug: hairType.slug }, props: { kind: "hairType", hairType } })),
    ...hairSubtypes.map((hairSubtype) => ({
      params: { slug: hairSubtype.slug },
      props: { kind: "hairSubtype", hairSubtype },
    })),
  ];
}

const kind = Astro.props.kind as "hairType" | "hairSubtype";
const hairType = Astro.props.hairType!;
const hairSubtype = Astro.props.hairSubtype!;
const subtypes = kind === "hairType" ? hairSubtypes.filter((item) => item.hairTypeId === hairType.id) : [];
const selected = kind === "hairType" ? hairType : hairSubtype;
const styles = getCompatibleHairstylesForHairTypeSlug(selected.slug).slice(0, 5);
const previewPeople = getPeopleForHairTypeSlug(selected.slug, { requireHeroImage: false, limit: 7 });
const label =
  kind === "hairType" ? `Type ${hairType.code}: ${hairType.name}` : `Type ${hairSubtype.code}: ${hairSubtype.name}`;
---

<Layout title={`${label} - hairhairhair.hair`} description={selected.description}>
  <div class="mt-2 mb-10 sm:mb-16">
    <HairTypeNavigator kind={kind} hairType={hairType} hairSubtype={hairSubtype} />
  </div>
  <article class="mx-auto max-w-7xl px-5 pb-14 pt-0 sm:px-8">
    <header class="border-b border-ink pb-8">
      <h1 class="mt-3 font-display text-5xl leading-[.95] tracking-[-.07em] sm:text-7xl">{label}</h1>
      <p class="mt-4 max-w-3xl text-lg leading-7 sm:text-xl">{selected.description}</p>
    </header>

    {kind === "hairType" ? (
      <section class="mt-9" aria-labelledby="subtypes-heading">
        <div class="flex items-baseline justify-between gap-4">
          <h2 id="subtypes-heading" class="font-display text-3xl">
            Explore the subtypes
          </h2>
          <a
            class="focus-ring text-xs font-black uppercase tracking-[.12em] text-orange hover:underline"
            href={`/hair-types/${hairType.slug}/people/`}
          >
            People
          </a>
        </div>
        <ul class="mt-5 grid gap-4 md:grid-cols-3">
          {subtypes.map((item) => (
            <li>
              <a
                href={`/hair-types/${item.slug}/`}
                class="hover-surface focus-ring group block rounded-3xl border-2 border-ink p-5 transition"
              >
                <Pattern pattern={item.pattern} subtype={item.subtypeCode} />
                <h3 class="mt-4 font-display text-2xl group-hover:underline">Type {item.code}</h3>
                <p class="mt-1">{item.name}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : (
      <div class="mt-7 grid gap-8 md:grid-cols-[1.2fr_.8fr]">
        <section>
          <h2 class="font-display text-3xl tracking-[-.05em]">What to notice</h2>
          <ul class="mt-4 space-y-3">
            {hairSubtype.characteristics.map((item) => (
              <li class="flex gap-3 leading-6">
                <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-orange"></span>
                {item}
              </li>
            ))}
          </ul>
        </section>
        <section class="inverse-panel rounded-3xl p-6">
          <p class="inverse-label text-xs font-black uppercase tracking-[.16em]">A useful comparison</p>
          <p class="mt-4 text-lg leading-7">{hairSubtype.comparison}</p>
        </section>
      </div>
    )}
  </article>

  <section class="mx-auto max-w-7xl px-5 pb-14 sm:px-8" aria-label={`Hairstyles for ${label}`}>
    <CollectionHeader
      title="Hairstyles for this type"
      href={`/hair-types/${selected.slug}/hairstyles/`}
      containerClass="items-center gap-4"
      linkClass="focus-ring text-xs font-normal uppercase tracking-[.16em] text-muted transition hover:text-ink"
    />
    <HairstyleGridData
      styles={styles}
      hairTypeId={kind === "hairType" ? hairType.id : undefined}
      className="mt-2.5 sm:mt-4 grid grid-flow-col auto-cols-[minmax(8rem,1fr)] gap-4 overflow-x-auto pb-3 lg:grid-flow-row lg:grid-cols-5 lg:auto-cols-auto lg:overflow-visible"
    />
  </section>
  {previewPeople.length > 0 && (
    <section
      class="mx-auto max-w-7xl px-5 pb-16 sm:px-8"
      aria-label="People with this natural hair type"
      data-testid="hair-type-celebrity-preview"
    >
      <CollectionHeader title="Celebs with this hair type" href={`/hair-types/${selected.slug}/people/`} />
      <CelebrityGrid people={previewPeople} />
    </section>
  )}
</Layout>
