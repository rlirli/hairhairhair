---
import { cn } from "../../lib/utils";
import AppearanceCard from "./AppearanceCard.astro";
import type { AppearanceCardData } from "./appearance-types";

interface Props {
  appearances: AppearanceCardData[];
  layout?: "row" | "grid";
  className?: string;
}

const { appearances, layout = "grid", className } = Astro.props;
---

<ul
  class={cn(
    layout === "row"
      ? "flex gap-3 overflow-x-auto overscroll-x-contain pb-3"
      : "grid grid-cols-2 gap-x-3 gap-y-4 sm:grid-cols-3 lg:grid-cols-6",
    className,
  )}
  aria-label={layout === "row" ? "Celebrity appearance previews" : undefined}
  tabindex={layout === "row" ? 0 : undefined}
>
  {appearances.map((appearance) => (
    <li class={cn("min-w-0", layout === "row" && "w-[min(72vw,14rem)] shrink-0 lg:w-[calc((100%_-_3.75rem)/6)]")}>
      <AppearanceCard {...appearance} />
    </li>
  ))}
</ul>

<script>
  document.querySelectorAll<HTMLTimeElement>("time[data-local-date]").forEach((element) => {
    const date = element.dateTime;
    const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(date);
    if (!match) return;

    const utcDate = new Date(Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3])));
    element.textContent = new Intl.DateTimeFormat(navigator.language, {
      dateStyle: "medium",
      timeZone: "UTC",
    }).format(utcDate);
  });
</script>
