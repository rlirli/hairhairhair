---
import Layout from "../../components/Layout.astro";
import Pattern from "../../components/Pattern.astro";
import RelatedHairstyleGrid from "../../components/RelatedHairstyleGrid.astro";
import HairTypeCelebrityPreview from "../../components/HairTypeCelebrityPreview.astro";
import { hairSubtypes, hairTypes } from "../../data/hair-types";
import { stylesForHairTypeSlug } from "../../data/hair-type-discovery";

export function getStaticPaths() {
  return [
    ...hairTypes.map((hairType) => ({ params: { slug: hairType.slug }, props: { kind: "hairType", hairType } })),
    ...hairSubtypes.map((hairSubtype) => ({
      params: { slug: hairSubtype.slug },
      props: { kind: "hairSubtype", hairSubtype },
    })),
  ];
}

const { kind } = Astro.props;
const hairType = Astro.props.hairType!;
const hairSubtype = Astro.props.hairSubtype!;
const subtypes = kind === "hairType" ? hairSubtypes.filter((item) => item.hairTypeId === hairType.id) : [];
const selected = kind === "hairType" ? hairType : hairSubtype;
const sequence = kind === "hairType" ? hairTypes : hairSubtypes;
const index = sequence.findIndex((item) => item.slug === selected.slug);
const previous = sequence[index - 1];
const next = sequence[index + 1];
const parentType = kind === "hairSubtype" ? hairTypes.find((item) => item.id === hairSubtype.hairTypeId) : undefined;
const styles = stylesForHairTypeSlug(selected.slug).slice(0, 5);
const label =
  kind === "hairType" ? `Type ${hairType.code} ${hairType.name}` : `Type ${hairSubtype.code} ${hairSubtype.name}`;
const navigatorLabel = kind === "hairType" ? label : `${hairSubtype.pattern} · Type ${parentType!.code}`;
---

<Layout title={`${label} — hairhairhair.hair`} description={selected.description}>
  <article class="mx-auto max-w-7xl px-5 pb-14 pt-7 sm:px-8">
    <nav
      class="mb-7 flex items-center justify-between gap-3 text-xs font-bold sm:text-sm"
      aria-label="Hair type sequence"
    >
      {previous ? (
        <a class="focus-ring min-w-0 truncate text-orange hover:underline" href={`/hair-types/${previous.slug}/`}>
          ← Type {previous.code} {previous.name}
        </a>
      ) : (
        <span />
      )}
      {kind === "hairSubtype" ? (
        <a
          class="focus-ring shrink-0 truncate uppercase tracking-[.12em] opacity-65 hover:opacity-100"
          href={`/hair-types/${parentType!.slug}/`}
        >
          {navigatorLabel}
        </a>
      ) : (
        <span class="shrink-0 truncate uppercase tracking-[.12em] opacity-60">{navigatorLabel}</span>
      )}
      {next ? (
        <a
          class="focus-ring min-w-0 truncate text-right text-orange hover:underline"
          href={`/hair-types/${next.slug}/`}
        >
          Type {next.code} {next.name} →
        </a>
      ) : (
        <span />
      )}
    </nav>

    <header class="border-b-2 border-ink pb-8">
      <h1 class="mt-3 font-display text-5xl leading-[.95] tracking-[-.07em] sm:text-7xl">{label}</h1>
      <p class="mt-4 max-w-3xl text-lg leading-7 sm:text-xl">{selected.description}</p>
    </header>

    {kind === "hairType" ? (
      <section class="mt-9" aria-labelledby="subtypes-heading">
        <div class="flex items-baseline justify-between gap-4">
          <h2 id="subtypes-heading" class="font-display text-3xl">
            Explore the subtypes
          </h2>
          <a
            class="focus-ring text-xs font-black uppercase tracking-[.12em] text-orange hover:underline"
            href={`/hair-types/${hairType.slug}/people/`}
          >
            People →
          </a>
        </div>
        <div class="mt-5 grid gap-4 md:grid-cols-3">
          {subtypes.map((item) => (
            <a
              href={`/hair-types/${item.slug}/`}
              class="hover-surface focus-ring rounded-3xl border-2 border-ink p-5 transition"
            >
              <Pattern pattern={item.pattern} subtype={item.subtypeCode} />
              <h3 class="mt-4 font-display text-2xl">Type {item.code}</h3>
              <p class="mt-1">{item.name}</p>
            </a>
          ))}
        </div>
      </section>
    ) : (
      <div class="mt-7 grid gap-8 md:grid-cols-[1.2fr_.8fr]">
        <section>
          <h2 class="font-display text-3xl tracking-[-.05em]">What to notice</h2>
          <ul class="mt-4 space-y-3">
            {hairSubtype.characteristics.map((item) => (
              <li class="flex gap-3 leading-6">
                <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-orange"></span>
                {item}
              </li>
            ))}
          </ul>
        </section>
        <section class="inverse-panel rounded-3xl p-6">
          <p class="inverse-label text-xs font-black uppercase tracking-[.16em]">A useful comparison</p>
          <p class="mt-4 text-lg leading-7">{hairSubtype.comparison}</p>
        </section>
      </div>
    )}
  </article>

  <section class="mx-auto max-w-7xl px-5 pb-14 sm:px-8" aria-label={`Hairstyles for ${label}`}>
    <div class="flex items-center justify-between gap-4">
      <h2 class="text-xs font-black uppercase tracking-[.16em] text-orange">Hairstyles for this type</h2>
      <a
        class="focus-ring text-xs font-normal uppercase tracking-[.16em] text-ink/60 transition hover:text-orange"
        href={`/hair-types/${selected.slug}/hairstyles/`}
      >
        More
      </a>
    </div>
    <RelatedHairstyleGrid
      styles={styles}
      className="mt-3 grid grid-flow-col auto-cols-[minmax(8rem,1fr)] gap-4 overflow-x-auto border-t border-ink/30 pt-5 pb-3 lg:grid-flow-row lg:grid-cols-5 lg:auto-cols-auto lg:overflow-visible"
    />
  </section>
  <HairTypeCelebrityPreview slug={selected.slug} />
</Layout>
