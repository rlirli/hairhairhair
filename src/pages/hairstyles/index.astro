---
import Layout from "../../components/shared/Layout.astro";
import HairstyleCard from "../../components/hairstyles/HairstyleCard.astro";
import { hairSubtypes, hairTypes } from "../../data/hair-types";
import { publishedHairstyles } from "../../data/hairstyles";
import { compatibleHairstylesForHairType } from "../../data/hairstyle-compatibility";
import { kindLabels } from "../../data/hairstyle-relations";
import DirectoryFilters, { type FilterGroup } from "../../components/shared/DirectoryFilters";

const kinds = Object.entries(kindLabels).map(([id, label]) => ({ id, label }));
const hairTypeParents = hairTypes.map((type) => ({
  id: type.id,
  label: `Type ${type.code}`,
  children: hairSubtypes
    .filter((subtype) => subtype.hairTypeId === type.id)
    .sort((left, right) => left.sortOrder - right.sortOrder)
    .map((subtype) => ({ id: subtype.id, label: `Type ${subtype.code}` })),
}));
const hairTypeOptions = [
  ...hairTypes.map((type) => ({ id: type.id, label: `Type ${type.code}` })),
  ...hairSubtypes.map((type) => ({ id: type.id, label: `Type ${type.code}` })),
];
const compatibleStylesByType = new Map(
  hairTypeOptions.map(
    (type) => [type.id, new Set(compatibleHairstylesForHairType(type.id).map((style) => style.id))] as const,
  ),
);
const hairTypeIdsForStyle = (styleId: string) =>
  hairTypeOptions.filter((type) => compatibleStylesByType.get(type.id)?.has(styleId)).map((type) => type.id);
const filterGroups: FilterGroup[] = [
  { key: "kind", label: "Kind", options: kinds },
  { key: "hair-type", label: "Hair type", parents: hairTypeParents },
];
---

<Layout
  title="Hairstyles - hairhairhair.hair"
  description="Research-backed hairstyle profiles for naming a look and preparing for a consultation."
>
  <section class="mx-auto max-w-7xl px-5 pb-3 pt-14 sm:px-8">
    <p class="text-xs font-black uppercase tracking-[.2em] text-orange">The hairstyle collection</p>
    <h1 class="mt-3 max-w-4xl font-display text-6xl leading-[.88] tracking-[-.08em] sm:text-8xl">
      Name the look.
      <br />
      <span class="text-orange">Plan the conversation.</span>
    </h1>
    <p class="mt-8 max-w-2xl text-lg leading-7">
      Explore cuts, finishing techniques, and ways of arranging hair. Use them to find precise words before you sit in
      the chair.
    </p>
    <a
      class="focus-ring mt-5 inline-flex items-center gap-2 text-sm font-bold text-orange hover:underline"
      href="/hairstyle-map/"
    >
      Explore the hairstyle map <span aria-hidden="true">↗︎</span>
    </a>
  </section>
  <section class="mx-auto max-w-7xl px-5 pt-16 sm:pt-2 pb-20 sm:px-8">
    <div class="border-b border-taupe pb-1.5 pr-1.5">
      <DirectoryFilters
        client:load
        groups={filterGroups}
        itemLabel="hairstyle"
        pluralItemLabel="hairstyles"
      />
    </div>
    <p class="sr-only" data-directory-results role="status" aria-live="polite"></p>
    <ul class="mt-6 grid list-none gap-x-3 gap-y-5 grid-cols-2 sm:gap-x-3.5 md:grid-cols-3 lg:grid-cols-4" data-hairstyle-grid>
      {publishedHairstyles.map((style) => (
        <li
          data-directory-item
          data-filter-kind={style.kind}
          data-filter-hair-type={hairTypeIdsForStyle(style.id).join(",")}
        >
          <HairstyleCard style={style} />
        </li>
      ))}
    </ul>
    <p class="mt-4 hidden text-sm text-ink/60" data-directory-empty>
      No hairstyles match these filters.
    </p>
  </section>
</Layout>
