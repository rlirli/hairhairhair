---
import type { PersonMedia } from "../data/people-media";

interface Props {
  media: PersonMedia;
  density: "compact" | "default";
  linkLicense: boolean;
}

const { media, density, linkLicense } = Astro.props;
---

<p class:list={["text-xs leading-5 opacity-75", density === "compact" ? "mt-2" : "mt-3"]}>
  <span class="font-bold">{media.provenance.attribution}</span>
  {media.provenance.derivativeStatus !== "original" && <> · {media.provenance.derivativeStatus} image</>}
  {" · "}
  {linkLicense ? (
    <a class="underline" href={media.provenance.licenseUrl} target="_blank" rel="noreferrer">
      {media.provenance.licenseName}
    </a>
  ) : (
    <span>{media.provenance.licenseName}</span>
  )}
</p>
