---
import { Image } from "astro:assets";
import straightTexture from "../../content/assets/hair-types/type-1-straight.png";
import wavyTexture from "../../content/assets/hair-types/type-2-wavy.png";
import curlyTexture from "../../content/assets/hair-types/type-3-curly.png";
import coilyTexture from "../../content/assets/hair-types/type-4-coily.png";
import type1A from "../../content/assets/hair-types/type-1a.png";
import type1B from "../../content/assets/hair-types/type-1b.png";
import type1C from "../../content/assets/hair-types/type-1c.png";
import type2A from "../../content/assets/hair-types/type-2a.png";
import type2B from "../../content/assets/hair-types/type-2b.png";
import type2C from "../../content/assets/hair-types/type-2c.png";
import type3A from "../../content/assets/hair-types/type-3a.png";
import type3B from "../../content/assets/hair-types/type-3b.png";
import type3C from "../../content/assets/hair-types/type-3c.png";
import type4A from "../../content/assets/hair-types/type-4a.png";
import type4B from "../../content/assets/hair-types/type-4b.png";
import type4C from "../../content/assets/hair-types/type-4c.png";

interface Props {
  pattern?: "straight" | "wavy" | "curly" | "coily";
  subtype?: "A" | "B" | "C";
  label?: string;
  caption?: string | false;
  layout?: "card" | "flush";
}

const { pattern = "wavy", subtype, label, caption, layout = "card" } = Astro.props;
const typeCodeByPattern = { straight: "1", wavy: "2", curly: "3", coily: "4" } as const;
const textureByPattern = {
  straight: straightTexture,
  wavy: wavyTexture,
  curly: coilyTexture,
  coily: curlyTexture,
};
const textureBySubtype = {
  straight: { A: type1A, B: type1B, C: type1C },
  wavy: { A: type2A, B: type2B, C: type2C },
  curly: { A: type3A, B: type3B, C: type3C },
  coily: { A: type4A, B: type4B, C: type4C },
};
const texture = subtype ? textureBySubtype[pattern][subtype] : textureByPattern[pattern];
const typeCode = `${typeCodeByPattern[pattern]}${subtype ?? ""}`;
const accessibleLabel = label ?? `Illustrative close-up of natural ${pattern} hair texture, Type ${typeCode}.`;
---

<div class:list={["overflow-hidden", layout === "card" && "rounded-2xl border border-ink/10 bg-white/30 p-2"]}>
  <Image
    src={texture}
    alt={accessibleLabel}
    class:list={["block aspect-[5/3] w-full object-cover", layout === "flush" ? "rounded-md" : "rounded-xl"]}
    widths={[320, 640]}
    sizes={
      layout === "flush"
        ? "(min-width: 1280px) 290px, (min-width: 768px) 25vw, 50vw"
        : "(min-width: 768px) 320px, 100vw"
    }
  />
  {caption !== false && (
    <span class="block px-2 pb-1 pt-2 text-[10px] font-bold uppercase tracking-[.1em]">
      {caption ?? `Type ${typeCode} · ${pattern} texture`}
    </span>
  )}
</div>
