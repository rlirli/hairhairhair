---
import { Image } from "astro:assets";
import Layout from "../../../../components/Layout.astro";
import { buildPersonMedia } from "../../../../data/people-media";
import { appearances, people, personPhotographs } from "../../../../data/people";
import { observedStylesForAppearance } from "../../../../data/people-relations";
import PersonPhotoAttribution from "../../../../components/PersonPhotoAttribution.astro";
import { formatAppearanceDate } from "../../../../lib/appearance-formatting";

export function getStaticPaths() {
  const media = buildPersonMedia(personPhotographs);
  return appearances.flatMap((appearance) => {
    const person = people.find((item) => item.id === appearance.personId);
    const photo = media.find((item) => item.id === appearance.imageId);
    return person && photo
      ? [
          {
            params: { slug: person.slug, appearanceId: appearance.id },
            props: { person, appearance, photo },
          },
        ]
      : [];
  });
}

const { person, appearance, photo } = Astro.props;
const observedStyles = observedStylesForAppearance(appearance.id);
---

<Layout
  title={`${formatAppearanceDate(appearance.taken.value)} — ${appearance.event} — ${person.name}`}
  description={`Appearance record for ${person.name} at ${appearance.event}.`}
  image={photo.src.src}
>
  <article class="mx-auto max-w-6xl px-5 pb-20 pt-12 sm:px-8">
    <nav aria-label="Breadcrumb" class="text-sm font-bold uppercase tracking-[.12em]">
      <a class="focus-ring text-orange" href="/">
        Home
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <a class="focus-ring text-orange" href="/people/">
        People
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <a class="focus-ring text-orange" href={`/people/${person.slug}/`}>
        {person.name}
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <a class="focus-ring text-orange" href={`/people/${person.slug}/appearances/`}>
        Appearances
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <span>{formatAppearanceDate(appearance.taken.value)}</span>
    </nav>

    <header class="mt-10 max-w-3xl sm:mt-12">
      <p class="text-xs font-black uppercase tracking-[.18em] text-orange">Appearance record</p>
      <h1 class="mt-4 font-display text-4xl leading-[.95] tracking-[-.05em] sm:text-5xl sm:leading-[.92]">
        {formatAppearanceDate(appearance.taken.value)}
      </h1>
      <p class="mt-5 text-lg leading-7 sm:text-xl sm:leading-8">{appearance.event}</p>
    </header>

    <div class="mt-12 grid gap-12 lg:grid-cols-[1.2fr_.8fr] lg:items-start">
      <figure>
        <a class="focus-ring group block" href={`/people/${person.slug}/photographs/${photo.id}/`}>
          <Image
            src={photo.src}
            widths={[600, 1000, 1400]}
            sizes="(min-width: 1024px) 60vw, 100vw"
            format="webp"
            alt={photo.alt}
            class="aspect-[4/3] w-full rounded-[2rem] object-cover transition-transform duration-300 group-hover:scale-[1.01]"
            style={`object-position: ${photo.objectPosition}`}
          />
          <PersonPhotoAttribution media={photo} compact />
        </a>
        <figcaption class="mt-4 flex flex-wrap items-baseline justify-between gap-3 text-sm leading-6">
          <span>{photo.creator}</span>
          <a
            class="focus-ring font-bold text-orange underline decoration-orange decoration-2 underline-offset-4"
            href={`/people/${person.slug}/photographs/${photo.id}/`}
          >
            Photograph record ↗
          </a>
        </figcaption>
      </figure>

      <aside class="space-y-10">
        <section aria-labelledby="hairstyles-heading">
          <div class="border-b border-ink pb-3">
            <h2 id="hairstyles-heading" class="text-xs font-black uppercase tracking-[.16em] text-orange">
              Hairstyles observed
            </h2>
          </div>
          <div class="mt-5 space-y-7">
            {observedStyles.map(({ observation, style }) => (
              <article>
                <h3 class="font-display text-3xl leading-none tracking-[-.04em]">{style.name}</h3>
                <p class="mt-3 text-sm leading-6">{observation.note}</p>
                <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-xs font-bold uppercase tracking-[.1em]">
                  {style.guidePublicationStatus === "published" && (
                    <a
                      class="focus-ring text-orange underline decoration-orange decoration-2 underline-offset-4"
                      href={`/hairstyles/${style.slug}/`}
                    >
                      Guide ↗
                    </a>
                  )}
                  <a
                    class="focus-ring text-orange underline decoration-orange decoration-2 underline-offset-4"
                    href={`/people/${person.slug}/hairstyles/${style.slug}/`}
                  >
                    {person.name}'s record ↗
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section aria-labelledby="source-heading" class="border-t border-ink/25 pt-6">
          <h2 id="source-heading" class="text-xs font-black uppercase tracking-[.16em] text-orange">
            Sources
          </h2>
          <p class="mt-3 text-sm leading-6">
            Date and event details are recorded from the source photograph and its catalog record.
          </p>
          <a
            class="focus-ring mt-3 inline-block text-sm font-bold text-orange underline decoration-orange decoration-2 underline-offset-4"
            href={appearance.taken.sourceUrl}
            target="_blank"
            rel="noreferrer"
          >
            Open source record ↗
          </a>
        </section>
      </aside>
    </div>

    <nav class="mt-16 flex flex-wrap gap-x-6 gap-y-3 border-t border-ink pt-6 text-sm font-bold">
      <a
        class="focus-ring text-orange underline decoration-orange decoration-2 underline-offset-4"
        href={`/people/${person.slug}/`}
      >
        ← Back to {person.name}
      </a>
      <a
        class="focus-ring text-orange underline decoration-orange decoration-2 underline-offset-4"
        href={`/people/${person.slug}/appearances/`}
      >
        All appearances ↗
      </a>
    </nav>
  </article>
</Layout>
