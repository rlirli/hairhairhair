---
import Layout from "../../components/Layout.astro";
import PersonDirectoryCard from "../../components/PersonDirectoryCard";
import { hairSubtypes, hairTypes } from "../../data/hair-types";
import { people, personPhotographs } from "../../data/people";
import { naturalProfileForPerson, resolvedHairTypeForNaturalProfile } from "../../data/natural-profiles";
import { buildPersonMedia } from "../../data/people-media";

const mediaById = new Map(buildPersonMedia(personPhotographs).map((photo) => [photo.id, photo]));
const profileLabel = (value: string | null, labels: Record<string, string>) =>
  value ? (labels[value] ?? value) : null;
const peopleCards = people.flatMap((person) => {
  const image = mediaById.get(person.heroImageId);
  if (!image) return [];

  const profile = naturalProfileForPerson(person.id);
  const resolvedType = profile ? resolvedHairTypeForNaturalProfile(profile) : undefined;
  const majorTypeId = profile?.hairTypeId.value;
  const subtypeId = profile?.hairSubtypeId.value;
  const hairValues = [majorTypeId, subtypeId].filter((value): value is string => Boolean(value));
  const profileRows = profile
    ? [
        resolvedType && {
          label: "Hair type",
          value: `Type ${resolvedType.code} · ${resolvedType.name}`,
          href: `/hair-types/${resolvedType.slug}/`,
        },
        profile.naturalHairColor.value && {
          label: "Hair color",
          value: profileLabel(profile.naturalHairColor.value, {
            black: "Black",
            brown: "Brown",
            blonde: "Blonde",
            red: "Red",
            gray: "Gray",
            white: "White",
          })!,
        },
        profile.naturalSkinTone.value && {
          label: "Skin tone",
          value: profileLabel(profile.naturalSkinTone.value, {
            "deep-brown": "Deep brown",
            brown: "Brown",
            medium: "Medium",
            light: "Light",
            fair: "Fair",
          })!,
        },
        profile.hairThickness.value && {
          label: "Hair thickness",
          value: profileLabel(profile.hairThickness.value, { fine: "Fine", medium: "Medium", coarse: "Coarse" })!,
        },
        profile.hairDensity.value && {
          label: "Hair density",
          value: profileLabel(profile.hairDensity.value, { low: "Low", medium: "Medium", high: "High" })!,
        },
      ].filter((row): row is NonNullable<typeof row> => Boolean(row))
    : [];

  return [
    {
      href: `/people/${person.slug}/`,
      name: person.name,
      imageSrc: image.src.src,
      imageAlt: image.alt,
      description: person.description,
      profileValues: {
        hair: hairValues,
        color: profile?.naturalHairColor.value ?? "",
        skin: profile?.naturalSkinTone.value ?? "",
      },
      profileRows,
    },
  ];
});
const observedHairTypes = new Set(peopleCards.flatMap((person) => person.profileValues.hair));
const observedColors = [...new Set(peopleCards.map((person) => person.profileValues.color).filter(Boolean))];
const observedSkinTones = [...new Set(peopleCards.map((person) => person.profileValues.skin).filter(Boolean))];
const hairTypeOptions = [
  ...hairTypes
    .filter((type) => observedHairTypes.has(type.id))
    .map((type) => ({ id: type.id, label: `Type ${type.code}` })),
  ...hairSubtypes
    .filter((type) => observedHairTypes.has(type.id))
    .map((type) => ({ id: type.id, label: `Type ${type.code}` })),
];
const colorLabels: Record<string, string> = {
  black: "Black",
  brown: "Brown",
  blonde: "Blonde",
  red: "Red",
  gray: "Gray",
  white: "White",
};
const skinLabels: Record<string, string> = {
  "deep-brown": "Deep brown",
  brown: "Brown",
  medium: "Medium",
  light: "Light",
  fair: "Fair",
};
const filterGroups = [
  { key: "hair", label: "Hair type", options: hairTypeOptions },
  { key: "color", label: "Color", options: observedColors.map((value) => ({ id: value, label: colorLabels[value] })) },
  {
    key: "skin",
    label: "Skin tone",
    options: observedSkinTones.map((value) => ({ id: value, label: skinLabels[value] })),
  },
];
---

<Layout
  title="Celebrities - hairhairhair.hair"
  description="Browse celebrities by natural hair type, hair color, or skin tone."
>
  <section class="mx-auto max-w-7xl px-5 pb-20 pt-14 sm:px-8">
    <p class="text-xs font-black uppercase tracking-[.2em] text-orange">Browse celebrities</p>
    <h1 class="mt-3 max-w-4xl font-display text-6xl leading-[.88] tracking-[-.08em] sm:text-8xl">
      A look at
      <br />
      <span class="text-orange">the record.</span>
    </h1>
    <div class="mt-10 border-b border-ink/30 pb-1.5 pr-1.5">
      <div class="flex justify-end gap-3 text-xs font-normal text-ink/60 sm:gap-5" data-profile-filters>
        {filterGroups.map((group) => (
          <details class="relative" data-profile-filter={group.key}>
            <summary class="focus-ring flex cursor-pointer uppercase list-none items-center gap-1 whitespace-nowrap">
              <span data-filter-label data-default-label={group.label}>
                {group.label}
              </span>
              <span aria-hidden="true" class="relative -top-0.75">
                ⌄
              </span>
            </summary>
            <fieldset class="absolute right-0 top-full z-30 mt-2 max-h-64 w-56 overflow-auto rounded-xl border border-ink/20 bg-ivory p-3 shadow-lg">
              <legend class="sr-only">{group.label}</legend>
              <div class="grid gap-2">
                {group.options.map((option) => (
                  <label class="flex cursor-pointer items-center gap-2 text-sm font-normal text-ink/60">
                    <input class="accent-orange" type="checkbox" value={option.id} />
                    <span>{option.label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          </details>
        ))}
      </div>
    </div>
    <p class="sr-only" data-profile-results role="status" aria-live="polite"></p>
    <div class="mt-7 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6" data-people-grid>
      {peopleCards.map((person) => (
        <PersonDirectoryCard client:load person={person} />
      ))}
    </div>
    <p class="mt-8 hidden text-sm opacity-70" data-profile-empty>
      No celebrities match these filters.
    </p>
  </section>
</Layout>

<script>
  const filters = [...document.querySelectorAll<HTMLDetailsElement>("[data-profile-filter]")];
  const cards = [...document.querySelectorAll<HTMLElement>("[data-person-card]")];
  const results = document.querySelector<HTMLElement>("[data-profile-results]");
  const empty = document.querySelector<HTMLElement>("[data-profile-empty]");

  const update = () => {
    let visible = 0;
    for (const filter of filters) {
      const selected = [...filter.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')];
      const label = filter.querySelector<HTMLElement>("[data-filter-label]");
      if (label) {
        const fallback = label.dataset.defaultLabel ?? "";
        label.textContent =
          selected.length === 1 ? (selected[0].nextElementSibling?.textContent?.trim() ?? fallback) : fallback;
      }
    }
    for (const card of cards) {
      const matches = filters.every((filter) => {
        const dimension = filter.dataset.profileFilter;
        const selected = [...filter.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')].map(
          (input) => input.value,
        );
        if (selected.length === 0 || !dimension) return true;
        let values: string[];
        if (dimension === "hair") values = (card.dataset.profileHair ?? "").split(",");
        else if (dimension === "color") values = [card.dataset.profileColor ?? ""];
        else if (dimension === "skin") values = [card.dataset.profileSkin ?? ""];
        else return true;
        return selected.some((value) => values.includes(value));
      });
      card.classList.toggle("hidden", !matches);
      if (matches) visible += 1;
    }
    if (results) results.textContent = `${visible} ${visible === 1 ? "celebrity" : "celebrities"} shown`;
    if (empty) empty.classList.toggle("hidden", visible !== 0);
  };

  for (const filter of filters) filter.addEventListener("change", update);
  document.addEventListener("click", (event) => {
    for (const filter of filters) {
      if (event.target instanceof Node && !filter.contains(event.target)) filter.open = false;
    }
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    for (const filter of filters) {
      if (!filter.open) continue;
      filter.open = false;
      filter.querySelector("summary")?.focus();
    }
  });
  update();
</script>
