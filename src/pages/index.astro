---
import Layout from "../components/Layout.astro";
import Pattern from "../components/Pattern.astro";
import RelatedHairstyleGrid from "../components/RelatedHairstyleGrid.astro";
import { hairTypes } from "../data/hair-types";
import { publishedHairstyles } from "../data/hairstyles";
import { people } from "../data/people";
---

<Layout>
  <section class="relative mx-auto max-w-7xl overflow-hidden px-5 pb-20 pt-12 sm:px-8 lg:pb-24 lg:pt-20">
    <div class="texture pointer-events-none absolute inset-0 -z-10"></div>
    <div class="max-w-5xl">
      <p class="mb-7 text-xs font-black uppercase tracking-[.2em] text-orange">An illustrated hair atlas</p>
      <h1 class="max-w-4xl font-display text-[clamp(4.2rem,12vw,10.5rem)] leading-[.8] tracking-[-.09em]">
        Your hair,
        <br />
        <em class="text-orange">mapped.</em>
      </h1>
      <p class="mt-10 max-w-md text-lg leading-7">
        Hair is wonderfully specific. Browse a clear, visual language for the patterns and textures that make it yours.
      </p>
      <a
        href="/hair-types/"
        class="action-primary focus-ring mt-8 inline-flex rounded-full border-2 border-ink px-6 py-3 text-sm font-black uppercase tracking-[.1em] transition"
      >
        <span>Explore hair types</span>{" "}
      </a>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8" id="about">
    <div class="mb-8 flex flex-col items-start gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-black uppercase tracking-[.2em] text-orange">Natural hair</p>
        <h2 class="mt-2 font-display text-5xl tracking-[-.06em]">The four hair types</h2>
      </div>
      <a href="/hair-types/" class="focus-ring text-sm font-normal text-muted transition hover:text-ink">
        See all types
      </a>
    </div>
    <p class="mb-8 max-w-2xl text-lg leading-7">
      This Walker-inspired chart classifies visible natural hair patterns into four numbered types - straight, wavy,
      curly, and coily - with lettered sub-types for more specific pattern descriptions.
    </p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {hairTypes.map((hairType) => (
        <a
          href={`/hair-types/${hairType.slug}/`}
          class="hover-surface focus-ring group rounded-3xl border-2 border-ink bg-white/30 p-5 transition hover:-translate-y-1"
        >
          <h3 class="font-display text-3xl tracking-[-.05em] group-hover:underline">
            <strong>Type {hairType.code}:</strong> {hairType.name}
          </h3>
          <div class="mt-5">
            <Pattern
              pattern={hairType.pattern}
              subtype="B"
              label={`Simplified Type ${hairType.code} ${hairType.name.toLowerCase()} pattern illustration - not a diagnostic or photograph`}
              caption={false}
            />
          </div>
          <p class="mt-2 text-sm leading-5">{hairType.description}</p>
        </a>
      ))}
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="text-xs font-black uppercase tracking-[.2em] text-orange">New collection</p>
        <h2 class="mt-2 font-display text-5xl tracking-[-.06em]">Hairstyles</h2>
        <p class="mt-4 max-w-xl text-lg leading-7">
          Find the words for a cut, finishing technique, or temporary style before your consultation.
        </p>
      </div>
      <a href="/hairstyles/" class="focus-ring text-sm font-normal opacity-60 transition hover:opacity-100">
        Browse all hairstyles
      </a>
    </div>
    <RelatedHairstyleGrid
      styles={publishedHairstyles.slice(0, 4)}
      size="medium"
      className="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4"
    />
  </section>
  <section class="mx-auto max-w-7xl px-5 pb-20 sm:px-8">
    <div class="rounded-[2rem] border-2 border-ink p-7 sm:p-10">
      <p class="text-xs font-black uppercase tracking-[.2em] text-orange">Get inspired</p>
      <h2 class="mt-3 font-display text-5xl tracking-[-.06em]">A look at the record.</h2>
      <p class="mt-4 max-w-2xl text-lg leading-7">
        Browse celebrities who share your hair type or skin tone, and see the hairstyles they have worn.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        {people.slice(0, 8).map((person) => (
          <a
            href={`/people/${person.slug}/`}
            class="hover-surface focus-ring rounded-full border border-ink/40 px-4 py-2 text-sm font-normal"
          >
            {person.name}
          </a>
        ))}
      </div>
      <a
        href="/people/"
        class="focus-ring mt-6 inline-block text-sm font-normal opacity-60 transition hover:opacity-100"
      >
        Browse all celebs
      </a>
    </div>
  </section>
</Layout>
