---
import { Image } from "astro:assets";
import Layout from "../../../../components/shared/Layout.astro";
import { appearances, people, personPhotographs } from "../../../../data/people";
import { observedStylesForAppearance } from "../../../../data/people-relations";
import { appearanceTitle, formatAppearanceDate } from "../../../../lib/appearance-formatting";

export function getStaticPaths() {
  const media = personPhotographs;
  return people.flatMap((person) =>
    media
      .filter((photo) =>
        appearances.some((appearance) => appearance.personId === person.id && appearance.imageId === photo.id),
      )
      .map((photo) => ({
        params: { slug: person.slug, photoId: photo.id },
        props: { person, photo },
      })),
  );
}

const { person, photo } = Astro.props;
const photoAppearances = appearances
  .filter((appearance) => appearance.personId === person.id && appearance.imageId === photo.id)
  .sort((a, b) => b.taken.value.localeCompare(a.taken.value));
const photoStyles = photoAppearances.flatMap((appearance) =>
  observedStylesForAppearance(appearance.id).map(({ style }) => style),
);
const uniqueStyles = photoStyles.filter(
  (style, index) => photoStyles.findIndex((item) => item.id === style.id) === index,
);
---

<Layout
  title={`${photo.provenance.identifier || photo.id} photograph - ${person.name} - hairhairhair.hair`}
  description={`Source, license, and usage record for a photograph of ${person.name}.`}
  image={photo.image.src}
>
  <article class="mx-auto max-w-5xl px-5 pb-20 pt-12 sm:px-8">
    <nav aria-label="Breadcrumb" class="text-sm font-bold uppercase tracking-[.12em]">
      <a class="focus-ring text-orange" href="/">
        Home
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <a class="focus-ring text-orange" href="/people/">
        People
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <a class="focus-ring text-orange" href={`/people/${person.slug}/`}>
        {person.name}
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <span>Photograph</span>
    </nav>

    <header class="mt-10 max-w-3xl sm:mt-12">
      <p class="text-xs font-black uppercase tracking-[.18em] text-orange">Photograph record</p>
      <h1 class="mt-4 font-display text-4xl leading-[.95] tracking-[-.05em] sm:text-5xl sm:leading-[.92]">
        {photo.provenance.identifier || photo.id}
      </h1>
      <p class="mt-5 text-lg leading-7">A source and usage record for this image of {person.name}.</p>
    </header>

    <figure class="mt-12">
      <Image
        src={photo.image}
        widths={[600, 1000, 1400]}
        sizes="(min-width: 1024px) 70vw, 100vw"
        format="webp"
        alt={photo.alt}
        class="max-h-[75vh] w-full object-contain"
        style={photo.objectPosition ? `object-position: ${photo.objectPosition}` : undefined}
      />
      <figcaption class="mt-5 border-l-4 border-orange pl-4 text-sm leading-6">
        {photo.provenance.creator && <p>{photo.provenance.creator}</p>}
        {photo.provenance.rightsBasis && <p>{photo.provenance.rightsBasis}</p>}
        <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
          {photo.provenance.sourceUrl && (
            <a
              class="focus-ring text-orange underline decoration-orange decoration-2 underline-offset-4"
              href={photo.provenance.sourceUrl}
              target="_blank"
              rel="noreferrer"
            >
              Source record
            </a>
          )}
          {photo.provenance.originalUrl && (
            <a
              class="focus-ring text-orange underline decoration-orange decoration-2 underline-offset-4"
              href={photo.provenance.originalUrl}
              target="_blank"
              rel="noreferrer"
            >
              Original file
            </a>
          )}
          {photo.provenance.rightsEvidenceUrl && (
            <a
              class="focus-ring text-orange underline decoration-orange decoration-2 underline-offset-4"
              href={photo.provenance.rightsEvidenceUrl}
              target="_blank"
              rel="noreferrer"
            >
              Rights evidence
            </a>
          )}
        </p>
        {(photo.provenance.identifier || photo.provenance.derivativeStatus || photo.provenance.licenseName) && (
          <p class="mt-2 opacity-70">
            {photo.provenance.identifier && <>Identifier: {photo.provenance.identifier}</>}
            {photo.provenance.derivativeStatus && <> · {photo.provenance.derivativeStatus} image</>}
            {photo.provenance.licenseName && (
              <>
                · License:{" "}
                {photo.provenance.licenseUrl ? (
                  <a class="focus-ring underline" href={photo.provenance.licenseUrl} target="_blank" rel="noreferrer">
                    {photo.provenance.licenseName}
                  </a>
                ) : (
                  photo.provenance.licenseName
                )}
              </>
            )}
          </p>
        )}
      </figcaption>
    </figure>

    <section class="mt-16" aria-labelledby="used-in-heading">
      <div class="border-b border-ink pb-3">
        <h2 id="used-in-heading" class="text-xs font-black uppercase tracking-[.18em] text-orange">
          Used in
        </h2>
      </div>
      <div class="mt-7 grid gap-8 md:grid-cols-2">
        <div>
          <h3 class="font-display text-3xl tracking-[-.03em]">Appearances</h3>
          <ul class="mt-4 space-y-3 text-sm leading-6">
            {photoAppearances.map((appearance) => (
              <li>
                <a
                  class="focus-ring font-bold text-orange underline decoration-orange decoration-2 underline-offset-4"
                  href={`/people/${person.slug}/appearances/${appearance.id}/`}
                >
                  {formatAppearanceDate(appearance.taken.value)} · {appearanceTitle(appearance.event)}
                </a>
                <p class="mt-1">{appearance.event}</p>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="font-display text-3xl tracking-[-.03em]">Hairstyle records</h3>
          {uniqueStyles.length ? (
            <ul class="mt-4 space-y-3 text-sm leading-6">
              {uniqueStyles.map((style) => (
                <li>
                  <a
                    class="focus-ring font-bold text-orange underline decoration-orange decoration-2 underline-offset-4"
                    href={`/people/${person.slug}/hairstyles/${style.slug}/`}
                  >
                    {style.name} - {person.name}'s record
                  </a>
                  {style.guidePublicationStatus === "published" && (
                    <a
                      class="focus-ring ml-3 text-orange underline decoration-orange decoration-2 underline-offset-4"
                      href={`/hairstyles/${style.slug}/`}
                    >
                      Hairstyle
                    </a>
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-4 text-sm leading-6">No hairstyle is linked to this photograph yet.</p>
          )}
        </div>
      </div>
    </section>

    <a
      class="focus-ring mt-14 inline-block font-bold text-orange underline decoration-orange decoration-2 underline-offset-4"
      href={`/people/${person.slug}/`}
    >
      Back to {person.name}
    </a>
  </article>
</Layout>
