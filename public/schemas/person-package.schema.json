{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hairhairhair.hair/schemas/person-package.schema.json",
  "title": "Hairhairhair person package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "person",
    "naturalProfile",
    "photographs",
    "appearances"
  ],
  "properties": {
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "name",
        "description",
        "heroImageId",
        "sources"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^person-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "slug": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "heroImageId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/personSource" } }
      }
    },
    "naturalProfile": { "$ref": "#/$defs/naturalProfile" },
    "photographs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/photograph" } },
    "appearances": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/appearance" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "httpUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "personSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url"],
      "properties": { "kind": { "enum": ["photograph", "biography"] }, "url": { "$ref": "#/$defs/httpUrl" } }
    },
    "traitProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "status",
        "confidence",
        "note"
      ],
      "properties": {
        "source": { "enum": [
            "ai-prefill",
            "community-correction",
            "self-reported",
            "not-documented"
          ] },
        "status": { "enum": ["unverified", "community-corrected"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "trait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance"],
      "properties": { "value": {}, "provenance": { "$ref": "#/$defs/traitProvenance" } }
    },
    "naturalProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hairTypeId",
        "hairSubtypeId",
        "naturalHairColor",
        "naturalSkinTone",
        "hairThickness",
        "hairDensity"
      ],
      "properties": {
        "hairTypeId": { "$ref": "#/$defs/hairTypeTrait" },
        "hairSubtypeId": { "$ref": "#/$defs/hairSubtypeTrait" },
        "naturalHairColor": { "$ref": "#/$defs/hairColorTrait" },
        "naturalSkinTone": { "$ref": "#/$defs/skinToneTrait" },
        "hairThickness": { "$ref": "#/$defs/thicknessTrait" },
        "hairDensity": { "$ref": "#/$defs/densityTrait" }
      }
    },
    "hairTypeTrait": {
      "allOf": [
        { "$ref": "#/$defs/trait" },
        { "properties": { "value": { "type": ["string", "null"], "pattern": "^hair-type-[1-4]$" } } }
      ]
    },
    "hairSubtypeTrait": {
      "allOf": [
        { "$ref": "#/$defs/trait" },
        { "properties": { "value": { "type": ["string", "null"], "pattern": "^hair-type-[1-4][a-c]$" } } }
      ]
    },
    "hairColorTrait": { "allOf": [{ "$ref": "#/$defs/trait" }, { "properties": { "value": { "enum": [
                "black",
                "brown",
                "blonde",
                "red",
                "gray",
                "white",
                null
              ] } } }] },
    "skinToneTrait": { "allOf": [{ "$ref": "#/$defs/trait" }, { "properties": { "value": { "enum": [
                "deep-brown",
                "brown",
                "medium",
                "light",
                "fair",
                null
              ] } } }] },
    "thicknessTrait": { "allOf": [{ "$ref": "#/$defs/trait" }, { "properties": { "value": { "enum": [
                "fine",
                "medium",
                "coarse",
                null
              ] } } }] },
    "densityTrait": { "allOf": [{ "$ref": "#/$defs/trait" }, { "properties": { "value": { "enum": [
                "low",
                "medium",
                "high",
                null
              ] } } }] },
    "photograph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fileName",
        "alt",
        "objectPosition",
        "provenance"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "fileName": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.(?:jpg|jpeg|png|webp)$" },
        "alt": { "type": "string", "minLength": 1 },
        "objectPosition": { "type": "string" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "licenseType",
            "creator",
            "licenseName",
            "licenseUrl",
            "attribution",
            "sourceUrl",
            "originalUrl",
            "rightsEvidenceUrl",
            "rightsBasis",
            "derivativeStatus"
          ],
          "properties": {
            "licenseType": { "enum": ["public-domain", "licensed"] },
            "costFree": { "type": "boolean" },
            "commercialUse": { "type": "boolean" },
            "derivativesAllowed": { "type": "boolean" },
            "creator": { "type": "string", "minLength": 1 },
            "licenseName": { "type": "string", "minLength": 1 },
            "licenseUrl": { "$ref": "#/$defs/httpUrl" },
            "attribution": { "type": "string", "minLength": 1 },
            "sourceUrl": { "$ref": "#/$defs/httpUrl" },
            "originalUrl": { "$ref": "#/$defs/httpUrl" },
            "rightsEvidenceUrl": { "$ref": "#/$defs/httpUrl" },
            "rightsBasis": { "type": "string", "minLength": 1 },
            "jurisdiction": { "type": "string" },
            "identifier": { "type": "string" },
            "derivativeStatus": { "enum": ["original", "cropped", "edited"] }
          },
          "allOf": [
            {
              "if": { "properties": { "licenseType": { "const": "licensed" } } },
              "then": {
                "required": ["costFree", "commercialUse", "derivativesAllowed"],
                "properties": {
                  "costFree": { "const": true },
                  "commercialUse": { "const": true },
                  "derivativesAllowed": { "const": true }
                }
              }
            }
          ]
        }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "imageId",
        "event",
        "taken",
        "observations"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^appearance-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "imageId": { "$ref": "#/$defs/slug" },
        "event": { "type": "string", "minLength": 1 },
        "taken": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "precision", "sourceUrl"],
          "properties": {
            "value": { "type": "string", "pattern": "^(?:[0-9]{4}|[0-9]{4}-[0-9]{2}-[0-9]{2})$" },
            "precision": { "enum": ["day", "year"] },
            "sourceUrl": { "$ref": "#/$defs/httpUrl" }
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hairstyleId", "note"],
            "properties": {
              "hairstyleId": {
                "type": "string",
                "pattern": "^(?:hairstyle-[a-z0-9]+(?:-[a-z0-9]+)*|PROPOSED-[a-z0-9]+(?:-[a-z0-9]+)*)$"
              },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
