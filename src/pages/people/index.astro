---
import Layout from "../../components/shared/Layout.astro";
import PersonDirectoryCard from "../../components/people/PersonDirectoryCard";
import { buildPersonDirectoryCardData } from "../../data/person-directory";
import { hairSubtypes, hairTypes } from "../../data/hair-types";
import { people, personPhotographs } from "../../data/people";
import DirectoryFilters, { type FilterGroup } from "../../components/shared/DirectoryFilters";

const mediaById = new Map(personPhotographs.map((photo) => [photo.id, photo]));
const peopleCards = people.flatMap((person) => {
  const image = mediaById.get(person.heroImageId);
  if (!image) return [];
  return [buildPersonDirectoryCardData(person, { src: image.image.src, alt: image.alt })];
});
const observedHairTypes = new Set(peopleCards.flatMap((person) => person.profileValues.hair));
const observedColors = [...new Set(peopleCards.map((person) => person.profileValues.color).filter(Boolean))];
const observedSkinTones = [...new Set(peopleCards.map((person) => person.profileValues.skin).filter(Boolean))];
const hairTypeOptions = [
  ...hairTypes
    .filter((type) => observedHairTypes.has(type.id))
    .map((type) => ({ id: type.id, label: `Type ${type.code}` })),
  ...hairSubtypes
    .filter((type) => observedHairTypes.has(type.id))
    .map((type) => ({ id: type.id, label: `Type ${type.code}` })),
];
const colorLabels: Record<string, string> = {
  black: "Black",
  brown: "Brown",
  blonde: "Blonde",
  red: "Red",
  gray: "Gray",
  white: "White",
};
const skinLabels: Record<string, string> = {
  "deep-brown": "Deep brown",
  brown: "Brown",
  medium: "Medium",
  light: "Light",
  fair: "Fair",
};
const filterGroups: FilterGroup[] = [
  { key: "hair", label: "Hair type", options: hairTypeOptions },
  { key: "color", label: "Color", options: observedColors.map((value) => ({ id: value, label: colorLabels[value] })) },
  {
    key: "skin",
    label: "Skin tone",
    options: observedSkinTones.map((value) => ({ id: value, label: skinLabels[value] })),
  },
];
---

<Layout
  title="Celebrities - hairhairhair.hair"
  description="Browse celebrities by natural hair type, hair color, or skin tone."
>
  <section class="mx-auto max-w-7xl px-5 pb-3 pt-14 sm:px-8">
    <p class="text-xs font-black uppercase tracking-[.2em] text-orange">Browse celebrities</p>
    <h1 class="mt-3 max-w-4xl font-display text-6xl leading-[.88] tracking-[-.08em] sm:text-8xl">
      A look at
      <br />
      <span class="text-orange">the record.</span>
    </h1>
  </section>
  <section class="mx-auto max-w-7xl px-5 pt-16 sm:pt-2 pb-20 sm:px-8">
    <div class="border-b border-taupe pb-1.5 pr-1.5">
      <DirectoryFilters client:load groups={filterGroups} itemLabel="celebrity" pluralItemLabel="celebrities" />
    </div>
    <p class="sr-only" data-directory-results role="status" aria-live="polite"></p>
    <ul
      class="mt-6 grid list-none gap-x-3 gap-y-5 grid-cols-2 sm:gap-x-3.5 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6"
      data-people-grid
    >
      {peopleCards.map((person) => (
        <li
          data-directory-item
          data-filter-hair={person.profileValues.hair.join(",")}
          data-filter-color={person.profileValues.color}
          data-filter-skin={person.profileValues.skin}
        >
          <PersonDirectoryCard client:load person={person} />
        </li>
      ))}
    </ul>
    <p class="mt-4 hidden text-sm text-ink/60" data-directory-empty>
      No celebrities match these filters.
    </p>
  </section>
</Layout>
