---
import type { ImageMedia } from "../../data/media-types";

interface Props {
  media: ImageMedia;
  density: "compact" | "default";
}

const { media, density } = Astro.props;
const provenance = media.provenance;
const showAttribution = provenance.licenseType === "licensed";
---

{showAttribution &&
  (density === "compact" ? (
    <div
      class="absolute inset-x-0 bottom-0 z-10 bg-black/75 px-2 py-1.5 text-[.68rem] leading-[1.2] text-white"
      data-photo-attribution
      role="note"
      aria-label="Photo attribution"
    >
      {provenance.creator || provenance.attribution}
      {provenance.licenseUrl && (
        <>
          {" "}
          ·{" "}
          <a
            class="focus-ring underline decoration-white/70 underline-offset-2"
            href={provenance.licenseUrl}
            target="_blank"
            rel="noreferrer"
          >
            {provenance.licenseName || "License"}
          </a>
        </>
      )}
      {provenance.sourceUrl && (
        <>
          {" "}
          ·{" "}
          <a
            class="focus-ring underline decoration-white/70 underline-offset-2"
            href={provenance.sourceUrl}
            target="_blank"
            rel="noreferrer"
          >
            Source
          </a>
        </>
      )}
      {provenance.derivativeStatus && provenance.derivativeStatus !== "original" && (
        <> · {provenance.derivativeStatus}</>
      )}
      {provenance.identifier && <> · {provenance.identifier}</>}
    </div>
  ) : (
    <p class="mt-3 text-sm leading-5" data-photo-attribution>
      {provenance.creator || provenance.attribution}
      {provenance.licenseUrl && (
        <>
          {" "}
          ·{" "}
          <a class="focus-ring underline" href={provenance.licenseUrl} target="_blank" rel="noreferrer">
            {provenance.licenseName || "License"}
          </a>
        </>
      )}
      {provenance.sourceUrl && (
        <>
          {" "}
          ·{" "}
          <a class="focus-ring underline" href={provenance.sourceUrl} target="_blank" rel="noreferrer">
            Source
          </a>
        </>
      )}
      {provenance.derivativeStatus && provenance.derivativeStatus !== "original" && (
        <> · {provenance.derivativeStatus}</>
      )}
    </p>
  ))}
