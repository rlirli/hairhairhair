---
import Layout from "../../../components/Layout.astro";
import RelatedHairstyleGrid from "../../../components/RelatedHairstyleGrid.astro";
import { hairFamilies, hairTypes } from "../../../data/hair-types";
import { publishedStylesForHairType } from "../../../data/hairstyle-relations";

export function getStaticPaths() {
  return hairTypes.map((hairType) => ({ params: { slug: hairType.slug }, props: { hairType } }));
}

const { hairType } = Astro.props;
const relatedStyles = publishedStylesForHairType(hairType.id);
const familyCode = hairFamilies.find((family) => family.family === hairType.family)?.code;
---

<Layout
  title={`Hairstyles for Type ${hairType.code} — hairhairhair.hair`}
  description={`Browse hairstyle guides related to Type ${hairType.code} ${hairType.name} hair.`}
>
  <main class="mx-auto max-w-7xl px-5 pb-20 pt-12 sm:px-8">
    <a
      class="focus-ring text-sm font-bold uppercase tracking-[.12em] text-orange"
      href={`/hair-types/${hairType.slug}/`}
    >
      ← Type {hairType.code}
    </a>
    <header class="mt-10">
      <p class="text-xs font-black uppercase tracking-[.18em] text-orange">Hairstyles for</p>
      <h1 class="mt-3 font-display text-6xl leading-[.88] tracking-[-.08em] sm:text-8xl">
        <a class="focus-ring hover:text-orange" href={`/hair-types/${hairType.slug}/`}>
          Hair Type {hairType.code}
        </a>
      </h1>
      <p class="mt-4 font-display text-2xl">{hairType.name}</p>
    </header>
    <section class="mt-10 border-t border-ink/30 pt-6" aria-label={`Hairstyles for Type ${hairType.code}`}>
      <RelatedHairstyleGrid
        styles={relatedStyles}
        size="medium"
        className="grid grid-cols-2 gap-x-5 gap-y-8 lg:grid-cols-4"
      />
    </section>
    <p class="mt-8 max-w-2xl text-sm leading-6">
      These guides inherit the broader Type {familyCode} family guidance. They are conversation references, not
      guaranteed results for a specific subtype.
    </p>
  </main>
</Layout>
