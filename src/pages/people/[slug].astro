---
import Layout from '../../components/Layout.astro';
import PersonPhoto from '../../components/PersonPhoto.astro';
import { Image } from 'astro:assets';
import { people, personPhotographs } from '../../data/people';
import { appearancesForPerson, observedStylesForAppearance } from '../../data/people-relations';
import { buildPersonMedia } from '../../data/people-media';

export function getStaticPaths() { return people.map((person) => ({ params: { slug: person.slug }, props: { person } })); }
const { person } = Astro.props;
const appearances = appearancesForPerson(person.id);
const media = buildPersonMedia(personPhotographs);
const hero = media.find((photo) => photo.id === person.heroImageId) ?? media[0];
const heroAppearance = appearances.find((appearance) => appearance.imageId === person.heroImageId);
---
<Layout title={`${person.name} — people — hairhairhair.hair`} description={person.description} image={hero ? hero.src.src : undefined}>
  <article class="mx-auto max-w-7xl px-5 pb-20 pt-12 sm:px-8">
    <nav aria-label="Breadcrumb" class="text-sm font-bold uppercase tracking-[.12em]"><a class="focus-ring text-orange" href="/">Home</a><span class="mx-2" aria-hidden="true">/</span><a class="focus-ring text-orange" href="/people/">People</a><span class="mx-2" aria-hidden="true">/</span><span>{person.name}</span></nav>
    <header class="mt-10 grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-center">
      <div>
        <p class="text-xs font-black uppercase tracking-[.18em] text-orange">Person record</p>
        <h1 class="mt-5 font-display text-7xl leading-[.84] tracking-[-.08em] sm:text-9xl">{person.name}</h1>
        <p class="mt-8 max-w-xl text-xl leading-8">{person.description}</p>
        {person.intro.map((paragraph: string) => <p class="mt-5 max-w-xl text-base leading-7">{paragraph}</p>)}
        <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-sm">
          {person.sourceUrls.map((sourceUrl, index) => <a class="focus-ring font-bold text-orange underline decoration-orange decoration-2 underline-offset-4" href={sourceUrl} target="_blank" rel="noreferrer">{index === 0 ? 'collection source' : 'biography source'} ↗</a>)}
        </div>
      </div>
      {hero && <figure><Image src={hero.src} widths={[400, 800, 1120]} sizes="(min-width: 1024px) 50vw, 100vw" format="webp" alt={hero.alt} class="aspect-[4/3] w-full rounded-[2rem] object-cover object-[60%_50%]" />{heroAppearance && <figcaption class="mt-3 text-sm leading-6"><a class="focus-ring font-bold text-orange underline decoration-orange decoration-2 underline-offset-4" href={`#${heroAppearance.id}`}>{heroAppearance.taken.value} · {heroAppearance.event} — photograph details ↓</a></figcaption>}</figure>}
    </header>
    <p class="mt-10 max-w-3xl border-l-4 border-orange pl-4 text-sm leading-6">The hairstyle labels below are editorial visual interpretations of each dated photograph, not verified stylist terminology or a permanent hair-type assignment.</p>
    <section class="mt-16">
      <p class="text-xs font-black uppercase tracking-[.18em] text-orange">Chronological appearances</p>
      <div class="mt-6 space-y-12">
        {appearances.map((appearance) => {
          const observations = observedStylesForAppearance(appearance.id);
          const photo = media.find((item) => item.id === appearance.imageId);
          return photo ? <PersonPhoto media={photo} event={appearance.event} date={appearance.taken.value} observations={observations.map(({ observation, style }) => ({ note: observation.note, styleName: style.name, styleSlug: style.slug }))} anchor={appearance.id} /> : null;
        })}
      </div>
    </section>
    <section class="mt-16 border-t-2 border-ink pt-8"><p class="text-xs font-black uppercase tracking-[.16em] text-orange">Rights note</p><p class="mt-3 max-w-3xl text-sm leading-6">Public-domain copyright status is recorded from the cited rights evidence and does not imply endorsement, personality-rights clearance, or that the pictured person approves this guide.</p></section>
  </article>
</Layout>
