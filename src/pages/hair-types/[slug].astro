---
import Layout from "../../components/Layout.astro";
import Pattern from "../../components/Pattern.astro";
import HairstyleCard from "../../components/HairstyleCard.astro";
import { hairTypes, hairFamilies } from "../../data/hair-types";
import { stylesForFamily } from "../../data/hairstyle-relations";
export function getStaticPaths() {
  return [
    ...hairFamilies.map((family) => ({ params: { slug: family.slug }, props: { kind: "family", family } })),
    ...hairTypes.map((hairType) => ({ params: { slug: hairType.slug }, props: { kind: "type", hairType } })),
  ];
}
const { kind } = Astro.props;
const family = Astro.props.family!;
const hairType = Astro.props.hairType!;
const familyTypes = kind === "family" ? hairTypes.filter((type) => type.family === family.family) : [];
const currentIndex = kind === "type" ? hairTypes.findIndex((item) => item.slug === hairType.slug) : -1;
const previous = currentIndex > 0 ? hairTypes[currentIndex - 1] : undefined;
const next = currentIndex < hairTypes.length - 1 ? hairTypes[currentIndex + 1] : undefined;
const familyCode = kind === "type" ? (hairFamilies.find((item) => item.family === hairType.family)?.code ?? "") : "";
const familyStyles = kind === "family" ? stylesForFamily(family.family) : stylesForFamily(hairType.family);
---

{kind === "family" ? (
  <Layout title={`Type ${family.code} ${family.name} hair — hairhairhair.hair`} description={family.description}>
    <article class="mx-auto max-w-7xl px-5 pb-20 pt-12 sm:px-8">
      <a class="focus-ring text-sm font-bold uppercase tracking-[.12em] text-orange" href="/hair-types/">
        ← All hair types
      </a>
      <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-center">
        <div>
          <p class="text-xs font-black uppercase tracking-[.18em]">Family {family.code}</p>
          <h1 class="mt-5 font-display text-7xl leading-[.82] tracking-[-.09em] sm:text-9xl">Type {family.code}</h1>
          <p class="mt-5 font-display text-3xl">{family.name}</p>
          <p class="mt-7 max-w-xl text-xl leading-8">{family.description}</p>
        </div>
        <Pattern
          family={family.family}
          subtype="B"
          label={`Simplified ${family.name} family pattern illustration — not a diagnostic or photograph`}
        />
      </div>
      <section class="mt-14 border-t-2 border-ink pt-8">
        <p class="text-xs font-black uppercase tracking-[.16em] text-orange">Explore the subtypes</p>
        <div class="mt-5 grid gap-4 md:grid-cols-3">
          {familyTypes.map((type) => (
            <a
              href={`/hair-types/${type.slug}/`}
              class="hover-surface focus-ring rounded-3xl border-2 border-ink p-5 transition"
            >
              <Pattern family={type.family} subtype={type.subtype} />
              <h2 class="mt-5 font-display text-3xl">Type {type.code}</h2>
              <p class="mt-1 font-display text-lg">{type.name}</p>
            </a>
          ))}
        </div>
      </section>
    </article>
    <section class="mx-auto max-w-7xl px-5 pb-20 sm:px-8">
      <p class="text-xs font-black uppercase tracking-[.16em] text-orange">Hairstyle guides</p>
      <div class="mt-5 grid gap-4 md:grid-cols-3">
        {familyStyles.map((item) => (
          <HairstyleCard style={item} compact />
        ))}
      </div>
    </section>
  </Layout>
) : (
  <Layout title={`Type ${hairType.code}: ${hairType.name} — hairhairhair.hair`} description={hairType.description}>
    <article class="mx-auto max-w-7xl px-5 pb-20 pt-12 sm:px-8">
      <a
        class="focus-ring text-sm font-bold uppercase tracking-[.12em] text-orange"
        href={`/hair-types/${familyCode}/`}
      >
        ← Type {familyCode} family
      </a>
      <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-center">
        <div>
          <p class="text-xs font-black uppercase tracking-[.18em]">
            {hairType.family} · {hairType.code}
          </p>
          <h1 class="mt-5 font-display text-7xl leading-[.82] tracking-[-.09em] sm:text-9xl">Type {hairType.code}</h1>
          <p class="mt-5 font-display text-3xl leading-tight tracking-[-.04em]">{hairType.name}</p>
          <p class="mt-7 max-w-xl text-xl leading-8">{hairType.description}</p>
        </div>
        <Pattern family={hairType.family} subtype={hairType.subtype} />
      </div>
      <p class="mt-8 max-w-2xl border-l-4 border-orange pl-4 text-sm leading-6">
        Pattern is one part of the picture. You may have more than one pattern on the same head. Thickness, density,
        porosity, and care history can change how any type looks and behaves.
      </p>
      <div class="mt-14 grid gap-5 border-t-2 border-ink pt-8 md:grid-cols-2">
        <section>
          <h2 class="font-display text-3xl tracking-[-.05em]">What to notice</h2>
          <ul class="mt-5 space-y-3">
            {hairType.characteristics.map((item) => (
              <li class="flex gap-3 text-base leading-6">
                <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-orange"></span>
                {item}
              </li>
            ))}
          </ul>
        </section>
        <section class="inverse-panel rounded-3xl p-7">
          <p class="inverse-label text-xs font-black uppercase tracking-[.16em]">A useful comparison</p>
          <p class="mt-5 text-lg leading-7">{hairType.comparison}</p>
        </section>
      </div>
      <nav class="mt-16 grid grid-cols-2 gap-4 border-t-2 border-ink pt-6" aria-label="Adjacent hair types">
        {previous ? (
          <a
            class="hover-surface focus-ring rounded-2xl border-2 border-ink p-4"
            href={`/hair-types/${previous.slug}/`}
          >
            <span class="block text-xs font-bold uppercase tracking-[.12em] text-orange">Previous</span>
            <span class="mt-2 block font-display text-2xl">Type {previous.code}</span>
            <span class="block text-sm">{previous.name}</span>
          </a>
        ) : (
          <span></span>
        )}
        {next ? (
          <a
            class="hover-surface focus-ring rounded-2xl border-2 border-ink p-4 text-right"
            href={`/hair-types/${next.slug}/`}
          >
            <span class="block text-xs font-bold uppercase tracking-[.12em] text-orange">Next</span>
            <span class="mt-2 block font-display text-2xl">Type {next.code}</span>
            <span class="block text-sm">{next.name}</span>
          </a>
        ) : (
          <span></span>
        )}
      </nav>
    </article>
    <section class="mx-auto max-w-7xl px-5 pb-20 sm:px-8">
      <p class="text-xs font-black uppercase tracking-[.16em] text-orange">Related hairstyle guides</p>
      <div class="mt-5 grid gap-4 md:grid-cols-3">
        {familyStyles.map((item) => (
          <HairstyleCard style={item} compact />
        ))}
      </div>
      <p class="mt-4 text-sm leading-6">
        These are family-level guides. They offer general conversation prompts, not evidence that a specific subtype
        will produce a guaranteed result.
      </p>
    </section>
  </Layout>
)}
