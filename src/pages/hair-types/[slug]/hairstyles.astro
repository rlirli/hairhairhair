---
import Layout from "../../../components/Layout.astro";
import RelatedHairstyleGrid from "../../../components/RelatedHairstyleGrid.astro";
import { hairSubtypes, hairTypes } from "../../../data/hair-types";
import { stylesForHairTypeSlug } from "../../../data/hair-type-discovery";

export function getStaticPaths() {
  return [...hairTypes, ...hairSubtypes].map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
const title = `Hairstyles for Type ${item.code} — hairhairhair.hair`;
const styles = stylesForHairTypeSlug(item.slug);
---

<Layout title={title} description={`Browse hairstyle guides related to Type ${item.code} ${item.name} hair.`}>
  <main class="mx-auto max-w-7xl px-5 pb-16 pt-8 sm:px-8">
    <a class="focus-ring text-xs font-bold uppercase tracking-[.12em] text-orange" href={`/hair-types/${item.slug}/`}>
      ← Type {item.code}
    </a>
    <header class="mt-6 border-b-2 border-ink pb-7">
      <p class="text-xs font-black uppercase tracking-[.18em] text-orange">Hairstyle guides</p>
      <h1 class="mt-2 font-display text-5xl leading-tight tracking-[-.07em] sm:text-7xl">
        Type {item.code} {item.name}
      </h1>
    </header>
    <section class="mt-7" aria-label={`Hairstyles for Type ${item.code}`}>
      <RelatedHairstyleGrid
        styles={styles}
        size="medium"
        className="grid grid-cols-2 gap-x-5 gap-y-8 md:grid-cols-3 lg:grid-cols-4"
      />
    </section>
  </main>
</Layout>
