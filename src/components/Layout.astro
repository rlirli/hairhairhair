---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = "hairhairhair.hair - explore hair types",
  description = "A visual introduction to hair type classification, from straight to coily.",
  image = "/og.svg",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    <meta name="twitter:card" content={image === "/og.svg" ? "summary" : "summary_large_image"} />
    <link rel="icon" href="/favicon.ico?v=20260922" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260922" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=20260922" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20260922" />
    <link rel="manifest" href="/site.webmanifest?v=20260922" />
    <meta name="theme-color" content="#f4f0e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#25231f" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-title" content="HairHairHair" />
    <script is:inline>
      (() => {
        const storageKey = "hairhairhair-theme";
        const themes = new Set(["system", "light", "dark"]);
        const root = document.documentElement;
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");
        const readPreference = () => {
          try {
            const saved = localStorage.getItem(storageKey);
            return saved && themes.has(saved) ? saved : "system";
          } catch {
            return "system";
          }
        };
        const apply = (preference) => {
          const dark = preference === "dark" || (preference === "system" && systemTheme.matches);
          root.classList.toggle("dark", dark);
          root.dataset.theme = preference;
          window.dispatchEvent(new CustomEvent("hairhairhair:theme-change", { detail: preference }));
        };
        const controller = {
          getPreference: readPreference,
          setPreference: (preference) => {
            if (!themes.has(preference)) return;
            try {
              localStorage.setItem(storageKey, preference);
            } catch {}
            apply(preference);
          },
          subscribe: (listener) => {
            const onChange = (event) => listener(event.detail);
            window.addEventListener("hairhairhair:theme-change", onChange);
            return () => window.removeEventListener("hairhairhair:theme-change", onChange);
          },
        };
        window.hairhairhairTheme = controller;
        apply(readPreference());
        const onSystemThemeChange = () => {
          if (readPreference() === "system") apply("system");
        };
        systemTheme.addEventListener("change", onSystemThemeChange);
      })();
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
