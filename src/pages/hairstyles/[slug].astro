---
import Layout from "../../components/Layout.astro";
import HairstyleCard from "../../components/HairstyleCard.astro";
import StyleMedia from "../../components/StyleMedia.astro";
import { getImage } from "astro:assets";
import { publishedHairstyles, sources, getExamplesForHairstyle } from "../../data/hairstyles";
import { publishedRelatedHairstyles } from "../../data/hairstyle-relations";
import { appearancesForStyle, personForAppearance } from "../../data/people-relations";
import { kindLabels } from "../../data/hairstyle-relations";
import { getMedia } from "../../data/media";
import { buildPersonMedia } from "../../data/people-media";
import { personPhotographs } from "../../data/people";
import HairstyleAppearanceGrid from "../../components/HairstyleAppearanceGrid.astro";

export function getStaticPaths() {
  return publishedHairstyles.map((style) => ({ params: { slug: style.slug }, props: { style } }));
}
const { style } = Astro.props;
const examples = getExamplesForHairstyle(style.id);
const heroMedia = examples[0]?.imageId;
const related = publishedRelatedHairstyles(style.relatedStyleIds);
const referencedSources = sources.filter((source) => style.sourceIds.includes(source.id));
const mediaById = new Map(buildPersonMedia(personPhotographs).map((media) => [media.id, media]));
const documentedAppearances = appearancesForStyle(style.id)
  .sort((a, b) => b.taken.value.localeCompare(a.taken.value))
  .map((appearance) => {
    const person = personForAppearance(appearance.id);
    const media = mediaById.get(appearance.imageId);
    return person && media
      ? {
          id: appearance.id,
          personSlug: person.slug,
          personName: person.name,
          date: appearance.taken.value,
          event: appearance.event,
          media,
        }
      : undefined;
  })
  .filter((item): item is NonNullable<typeof item> => Boolean(item));
const kindLabel = kindLabels[style.kind];
const ogImage = heroMedia
  ? (await getImage({ src: getMedia(heroMedia)!.src, width: 1120, format: "jpg" })).src
  : undefined;
---

<Layout title={`${style.name} — hairhairhair.hair`} description={style.summary} image={ogImage}>
  <article class="mx-auto max-w-7xl px-5 pb-20 pt-12 sm:px-8">
    <nav aria-label="Breadcrumb" class="text-sm font-bold uppercase tracking-[.12em]">
      <a class="focus-ring text-orange" href="/">
        Home
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <a class="focus-ring text-orange" href="/hairstyles/">
        Hairstyles
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <span>{style.name}</span>
    </nav>
    <div class="mt-10 grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
      <div>
        <p class="text-xs font-black uppercase tracking-[.18em]">{kindLabel}</p>
        <h1 class="mt-5 font-display text-6xl leading-[.84] tracking-[-.08em] sm:text-8xl">{style.name}</h1>
        {style.intro.map((paragraph: string) => (
          <p class="mt-6 max-w-xl text-lg leading-7">{paragraph}</p>
        ))}
      </div>
      <div>{heroMedia && <StyleMedia mediaId={heroMedia} eager />}</div>
    </div>
    <section class="mt-16 border-t-2 border-ink pt-10">
      <div class="flex items-baseline justify-between gap-4 border-b border-ink/30 pb-3">
        <h2 class="font-display text-3xl tracking-[-.06em]">Examples</h2>
        <a
          class="focus-ring text-xs font-normal uppercase tracking-[.12em] text-ink/60 transition hover:text-orange"
          href={`/hairstyles/${style.slug}/examples/`}
        >
          More
        </a>
      </div>
      <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {examples.slice(0, 4).map((example, index) => (
          <StyleMedia
            mediaId={example.imageId}
            title={example.title}
            caption={example.caption}
            patternDescription={example.patternDescription}
            lengthDescription={example.lengthDescription}
            eager={index === 0}
          />
        ))}
      </div>
    </section>
    <section class="mt-16 border-t-2 border-ink pt-8">
      <div class="flex items-baseline justify-between gap-4 border-b border-ink/30 pb-3">
        <h2 class="text-xs font-black uppercase tracking-[.18em] text-orange">Worn by celebs</h2>
        <a
          class="focus-ring text-xs font-normal uppercase tracking-[.12em] text-ink/60 transition hover:text-orange"
          href={`/hairstyles/${style.slug}/appearances/`}
        >
          More
        </a>
      </div>
      <p class="mt-3 max-w-2xl text-sm leading-6">
        Dated appearance photographs where this style has been visually documented.
      </p>
      {documentedAppearances.length > 0 ? (
        <div class="mt-5">
          <HairstyleAppearanceGrid appearances={documentedAppearances.slice(0, 6)} />
        </div>
      ) : (
        <p class="mt-5 text-sm leading-6">No dated appearance photographs are currently documented for this style.</p>
      )}
    </section>
    <section class="mt-16 grid gap-10 border-t-2 border-ink pt-10 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class="text-xs font-black uppercase tracking-[.18em] text-orange">Variations</p>
        <h2 class="mt-2 font-display text-4xl tracking-[-.06em]">Choose the details</h2>
        <div class="mt-6 space-y-5">
          {style.variations.map((variation) => (
            <div class="border-b border-ink/30 pb-4">
              <h3 class="font-display text-2xl">{variation.name}</h3>
              <p class="mt-1 text-base leading-6">{variation.description}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="inverse-panel rounded-[2rem] p-7">
        <p class="inverse-label text-xs font-black uppercase tracking-[.16em]">{style.consultation.intro}</p>
        <ul class="mt-5 space-y-3 text-lg leading-8">
          {style.consultation.questions.map((question: string) => (
            <li class="flex gap-3">
              <span aria-hidden="true">•</span>
              <span>{question}</span>
            </li>
          ))}
        </ul>
        <p class="mt-6 border-t border-current/30 pt-5 text-base leading-7">{style.consultation.sampleRequest}</p>
      </div>
    </section>
    <section class="mt-16 grid gap-10 border-t-2 border-ink pt-10 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class="text-xs font-black uppercase tracking-[.18em] text-orange">What changes the result</p>
        <h2 class="mt-2 font-display text-4xl tracking-[-.06em]">Bring these variables</h2>
        <ul class="mt-6 space-y-3">
          {style.considerations.map((item: string) => (
            <li class="flex gap-3 text-base leading-6">
              <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-orange"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </section>
    {related.length > 0 && (
      <section class="mt-16 border-t-2 border-ink pt-10">
        <p class="text-xs font-black uppercase tracking-[.18em] text-orange">Related Hairstyles</p>
        <div class="mt-5 grid gap-4 md:grid-cols-3">
          {related.map((item) => (
            <HairstyleCard style={item} compact />
          ))}
        </div>
      </section>
    )}
    <section class="mt-16 border-t-2 border-ink pt-8">
      <p class="text-xs font-black uppercase tracking-[.18em] text-orange">Sources reviewed</p>
      <div class="mt-4 space-y-2 text-sm leading-6">
        {referencedSources.map((source) => (
          <p>
            <a
              class="focus-ring underline decoration-orange decoration-2 underline-offset-4"
              href={source.url}
              target="_blank"
              rel="noreferrer"
            >
              {source.displayTitle ?? source.title}
            </a>{" "}
            · {source.publisher} · reviewed {source.reviewedAt}
          </p>
        ))}
      </div>
    </section>
  </article>
</Layout>
