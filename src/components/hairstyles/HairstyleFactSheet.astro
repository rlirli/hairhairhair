---
import { cn } from "../../lib/utils";
import { hairSubtypes, hairTypes } from "../../data/hair-types";
import { compatibilityForHairstyle } from "../../data/hairstyle-compatibility";
import type { EditorialSource, Hairstyle } from "../../data/hairstyles";

interface Props {
  style: Hairstyle;
  sources: EditorialSource[];
}

const { style, sources } = Astro.props;
const subtypeGroups = hairTypes.map((hairType) => ({
  hairType,
  subtypes: hairSubtypes
    .filter((subtype) => subtype.hairTypeId === hairType.id)
    .sort((left, right) => left.sortOrder - right.sortOrder)
    .map((subtype) => ({
      subtype,
      compatibility: compatibilityForHairstyle(style.id, subtype.id),
    })),
}));
const subtypeSegments = subtypeGroups.flatMap(({ hairType, subtypes }) =>
  subtypes.map(({ subtype, compatibility }) => ({ hairType, subtype, compatibility })),
);

const originRows = [
  style.inventedAt && {
    label: "Origin date",
    value:
      style.inventedAt.precision === "decade"
        ? `c. ${Math.floor(style.inventedAt.year / 10) * 10}s`
        : String(style.inventedAt.year),
    source: sources.find((source) => source.id === style.inventedAt?.sourceId),
  },
  style.inventor && {
    label: "Inventor",
    value: style.inventor.name,
    source: sources.find((source) => source.id === style.inventor?.sourceId),
  },
].filter((row): row is NonNullable<typeof row> => Boolean(row));
---

<section class="rounded-3xl border border-ink/25 p-5" aria-labelledby={`${style.id}-fact-sheet-title`}>
  <div class="border-b border-ink/25 pb-3">
    <h2 id={`${style.id}-fact-sheet-title`} class="text-xs font-black uppercase tracking-[.16em] text-orange">
      Style notes
    </h2>
  </div>
  <dl class="mt-2 divide-y divide-ink/10">
    <div class="pt-3 pb-1">
      <dt class="text-xs font-bold uppercase tracking-[.08em] opacity-65">Hair Type Compatibility</dt>
      <dd class="mt-3">
        <div
          class="grid grid-cols-12"
          role="group"
          aria-label="Subtype compatibility estimates in order from Type 1A through Type 4C"
        >
          {subtypeSegments.map(({ subtype, compatibility }, index) => {
            const score = compatibility?.score ?? null;
            const unknown = score === null;
            const firstSegment = index === 0;
            const lastSegment = index === subtypeSegments.length - 1;

            return (
              <div
                class={cn(
                  "relative h-3 overflow-hidden border-y border-r border-ink/25",
                  firstSegment && "rounded-l-full border-l",
                  lastSegment && "rounded-r-full",
                  unknown && "text-ink/30",
                )}
                role={unknown ? "img" : "meter"}
                aria-label={
                  unknown
                    ? `Type ${subtype.code}: compatibility estimate unknown`
                    : `Type ${subtype.code}: editorial compatibility estimate ${score}`
                }
                aria-valuemin={unknown ? undefined : "0"}
                aria-valuemax={unknown ? undefined : "1"}
                aria-valuenow={unknown ? undefined : score}
                data-hairstyle-compatibility={subtype.id}
                data-score={unknown ? "unknown" : score}
                title={`${subtype.code}: ${unknown ? "unknown" : `editorial estimate ${score}`}`}
                style={
                  unknown
                    ? "background-image: repeating-linear-gradient(135deg, transparent 0 2px, currentColor 2px 3px)"
                    : undefined
                }
              >
                {!unknown && <span class="absolute inset-0 bg-orange" style={`opacity: ${score}`} aria-hidden="true" />}
                <span class="sr-only">{subtype.code}</span>
              </div>
            );
          })}
        </div>
        <div class="mt-1 grid grid-cols-12 text-center">
          {subtypeGroups.map(({ hairType }) => (
            <a
              class="focus-ring col-span-3 text-[.62rem] font-bold uppercase tracking-[.08em] text-ink/60"
              href={`/hair-types/${hairType.slug}/`}
              aria-label={`Type ${hairType.code}`}
            >
              {hairType.code}
            </a>
          ))}
        </div>
        <p class="sr-only">
          Estimates describe how closely defining features can be achieved with ordinary cutting and styling while
          preserving the natural curl pattern, assuming sufficient length. They are not personal suitability scores,
          promises, or eligibility guidance. Each segment is labeled for screen readers with its subtype and resolved
          score.
        </p>
      </dd>
    </div>
    {originRows.map((row) => (
      <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,auto)] items-baseline gap-x-4 py-3">
        <dt class="text-xs font-bold uppercase tracking-[.08em] opacity-65">{row.label}</dt>
        <dd class="text-right text-sm font-bold">
          {row.value}
          {row.source && (
            <a
              class="focus-ring ml-2 text-xs font-normal text-orange underline decoration-orange underline-offset-2"
              href={row.source.url}
              target="_blank"
              rel="noreferrer"
            >
              Source
            </a>
          )}
        </dd>
      </div>
    ))}
  </dl>
</section>
