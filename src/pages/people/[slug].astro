---
import Layout from "../../components/Layout.astro";
import ExpandableBio from "../../components/ExpandableBio.astro";
import NaturalProfile from "../../components/NaturalProfile.astro";
import { Image } from "astro:assets";
import { people, personPhotographs } from "../../data/people";
import { appearancesForPerson, hairstylesForPerson } from "../../data/people-relations";
import { buildPersonMedia } from "../../data/people-media";
import { naturalProfileForPerson } from "../../data/natural-profiles";
import PersonPhotoAttribution from "../../components/PersonPhotoAttribution.astro";
import { appearanceTitle, formatAppearanceDate } from "../../lib/appearance-formatting";

export function getStaticPaths() {
  return people.map((person) => ({ params: { slug: person.slug }, props: { person } }));
}
const { person } = Astro.props;
const appearances = appearancesForPerson(person.id).sort((a, b) => b.taken.value.localeCompare(a.taken.value));
const hairstyleRecords = hairstylesForPerson(person.id);
const media = buildPersonMedia(personPhotographs);
const hero = media.find((photo) => photo.id === person.heroImageId) ?? media[0];
const naturalProfile = naturalProfileForPerson(person.id);
---

<Layout
  title={`${person.name} — people — hairhairhair.hair`}
  description={person.description}
  image={hero ? hero.src.src : undefined}
>
  <article class="mx-auto max-w-7xl px-5 pb-20 pt-12 sm:px-8">
    <nav aria-label="Breadcrumb" class="text-sm font-bold uppercase tracking-[.12em]">
      <a class="focus-ring text-orange" href="/">
        Home
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <a class="focus-ring text-orange" href="/people/">
        People
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <span>{person.name}</span>
    </nav>
    <header class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,.95fr)_minmax(0,1.2fr)_minmax(15rem,.85fr)] lg:items-start lg:gap-8 xl:gap-12">
      <div class="lg:pt-3">
        <p class="text-xs font-black uppercase tracking-[.18em] text-orange">Person record</p>
        <h1 class="mt-5 font-display text-6xl leading-[.84] tracking-[-.08em] sm:text-8xl xl:text-9xl">
          {person.name}
        </h1>
        <div class="mt-8">
          <p class="text-xs font-black uppercase tracking-[.14em] opacity-60">Mini bio</p>
          <ExpandableBio id={`person-${person.slug}-bio`} text={person.description} />
        </div>
        <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-sm">
          {person.sources.map(({ url, kind }) => (
            <a
              class="focus-ring font-bold text-orange underline decoration-orange decoration-2 underline-offset-4"
              href={url}
              target="_blank"
              rel="noreferrer"
            >
              {kind === "photograph" ? "photo source" : "bio source"} ↗
            </a>
          ))}
        </div>
      </div>
      {hero && (
        <figure class="relative overflow-hidden">
          <a
            class="focus-ring group block"
            href={`/people/${person.slug}/photographs/${hero.id}/`}
            aria-label={`View photograph details for ${person.name}`}
          >
            <Image
              src={hero.src}
              widths={[400, 800, 1120]}
              sizes="(min-width: 1280px) 38vw, (min-width: 768px) 40vw, 100vw"
              format="webp"
              alt={hero.alt}
              class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-[1.015]"
              style={`object-position: ${hero.objectPosition}`}
            />
          </a>
          <PersonPhotoAttribution media={hero} density="compact" />
        </figure>
      )}
      {naturalProfile && (
        <div class="lg:pt-3">
          <NaturalProfile profile={naturalProfile} />
        </div>
      )}
    </header>
    <section class="mt-20" aria-labelledby="appearances-heading">
      <div class="flex items-end justify-between gap-5 border-b border-ink pb-3">
        <h2 id="appearances-heading" class="text-xs font-black uppercase tracking-[.18em] text-orange">
          Appearances
        </h2>
        <a
          class="focus-ring text-xs font-normal uppercase tracking-[.14em] text-orange/70 transition hover:text-orange"
          href={`/people/${person.slug}/appearances/`}
        >
          More
        </a>
      </div>
      <div class="mt-7 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {appearances.slice(0, 4).map((appearance) => {
          const photo = media.find((item) => item.id === appearance.imageId);
          return photo ? (
            <article class="group">
              <figure>
                <div class="relative overflow-hidden">
                  <a
                    class="group focus-ring block"
                    href={`/people/${person.slug}/appearances/${appearance.id}/`}
                    aria-label={`${formatAppearanceDate(appearance.taken.value, "short")}: ${appearanceTitle(appearance.event)}`}
                  >
                    <Image
                      src={photo.src}
                      widths={[400, 700, 1000]}
                      sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                      format="webp"
                      alt={photo.alt}
                      class="aspect-square w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                      style={`object-position: ${photo.objectPosition}`}
                    />
                  </a>
                  <PersonPhotoAttribution media={photo} density="compact" />
                </div>
                <figcaption class="mt-4">
                  <p class="text-xs font-black uppercase tracking-[.14em] text-orange">
                    {formatAppearanceDate(appearance.taken.value, "short")}
                  </p>
                  <h3 class="mt-2 font-display text-xl leading-tight tracking-[-.02em]">
                    <a class="focus-ring" href={`/people/${person.slug}/appearances/${appearance.id}/`}>
                      {appearanceTitle(appearance.event)}
                    </a>
                  </h3>
                </figcaption>
              </figure>
            </article>
          ) : null;
        })}
      </div>
    </section>
    <section class="mt-20" aria-labelledby="hairstyles-heading">
      <div class="flex items-end justify-between gap-5 border-b border-ink pb-3">
        <h2 id="hairstyles-heading" class="text-xs font-black uppercase tracking-[.18em] text-orange">
          Hairstyles worn
        </h2>
        <a
          class="focus-ring text-xs font-normal uppercase tracking-[.14em] text-orange/70 transition hover:text-orange"
          href={`/people/${person.slug}/hairstyles/`}
        >
          More
        </a>
      </div>
      <div class="mt-7 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {hairstyleRecords.slice(0, 4).map(({ style, appearances: styleAppearances }) => {
          const appearance = styleAppearances[0];
          const photo = media.find((item) => item.id === appearance.imageId);
          return photo ? (
            <article class="group">
              <figure>
                <div class="relative overflow-hidden">
                  <a
                    class="group focus-ring block"
                    href={`/people/${person.slug}/hairstyles/${style.slug}/`}
                    aria-label={`${person.name} wearing ${style.name}`}
                  >
                    <Image
                      src={photo.src}
                      widths={[400, 700, 1000]}
                      sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                      format="webp"
                      loading="lazy"
                      alt={`${person.name} wearing ${style.name}`}
                      class="aspect-square w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                      style={`object-position: ${photo.objectPosition}`}
                    />
                  </a>
                  <PersonPhotoAttribution media={photo} density="compact" />
                </div>
                <figcaption class="mt-4">
                  <h3 class="font-display text-2xl leading-[.98] tracking-[-.03em]">
                    <a class="focus-ring" href={`/people/${person.slug}/hairstyles/${style.slug}/`}>
                      {style.name}
                    </a>
                  </h3>
                </figcaption>
              </figure>
            </article>
          ) : null;
        })}
      </div>
    </section>
  </article>
</Layout>
