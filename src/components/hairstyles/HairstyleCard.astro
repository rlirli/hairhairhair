---
import { Image } from "astro:assets";
import { kindLabels } from "../../data/hairstyle-relations";
import { representativeHairstyleMedia } from "../../data/hairstyle-representative-media";
import PhotoAttribution from "../shared/PhotoAttribution";
import type { Hairstyle } from "../../types";
interface Props {
  style: Hairstyle;
  compact?: boolean;
}
const { style, compact = false } = Astro.props;
const representative = representativeHairstyleMedia(style.id);
const media = representative?.media;
---

<div
  class={`hover-surface group flex h-full flex-col rounded-3xl border-2 border-ink p-3 transition ${compact ? "" : "sm:p-4"}`}
>
  {media && (
    <figure class="relative aspect-square overflow-hidden rounded-2xl">
      <a href={`/hairstyles/${style.slug}/`} class="focus-ring block">
        <Image
          src={media.image}
          widths={[400, 800]}
          sizes="(min-width: 1024px) 25vw, 100vw"
          format="webp"
          loading="lazy"
          alt={media.alt}
          class="aspect-square w-full rounded-2xl object-cover bg-hairstyle-image-bg"
        />
      </a>
      <PhotoAttribution provenance={media.provenance} density="compact" />
    </figure>
  )}
  <a href={`/hairstyles/${style.slug}/`} class="focus-ring flex flex-1 flex-col rounded-2xl">
    <p class="mt-3 text-xs font-black uppercase tracking-[.16em] text-orange">{kindLabels[style.kind]}</p>
    <h2 class="mt-1.5 font-display text-2xl tracking-[-.05em]">{style.name}</h2>
    <p class="mt-1 text-sm leading-5">{style.summary}</p>
  </a>
</div>
