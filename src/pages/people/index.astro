---
import Layout from "../../components/Layout.astro";
import { people } from "../../data/people";
---

<Layout title="People — hairhairhair.hair" description="Dated, source-attributed hairstyle appearances.">
  <section class="mx-auto max-w-7xl px-5 pb-20 pt-14 sm:px-8">
    <p class="text-xs font-black uppercase tracking-[.2em] text-orange">People and appearances</p>
    <h1 class="mt-3 max-w-4xl font-display text-6xl leading-[.88] tracking-[-.08em] sm:text-8xl">
      A look at
      <br />
      <span class="text-orange">the record.</span>
    </h1>
    <p class="mt-8 max-w-2xl text-lg leading-7">
      Dated photographs can show how a hairstyle reads at one moment. They do not assign a permanent hair type or
      explain the full story behind a look.
    </p>
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {people.map((person) => (
        <a class="hover-surface focus-ring rounded-3xl border-2 border-ink p-6" href={`/people/${person.slug}/`}>
          <p class="text-xs font-black uppercase tracking-[.16em] text-orange">Person record</p>
          <h2 class="mt-16 font-display text-4xl">{person.name}</h2>
          <p class="mt-2 text-lg leading-7">{person.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
