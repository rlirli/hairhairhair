---
import Layout from "../../components/Layout.astro";
import Pattern from "../../components/Pattern.astro";
import { hairSubtypes, hairTypes, classificationSystems } from "../../data/hair-types";
---

<Layout title="Hair types — hairhairhair.hair" description="Browse the complete hair type field guide.">
  <section class="mx-auto max-w-7xl px-5 pb-12 pt-14 sm:px-8">
    <p class="text-xs font-black uppercase tracking-[.2em] text-orange">The field guide</p>
    <h1 class="mt-3 max-w-3xl font-display text-6xl leading-[.9] tracking-[-.08em] sm:text-8xl">
      Find your
      <br />
      <span class="text-orange">pattern.</span>
    </h1>
    <p class="mt-8 max-w-xl text-lg leading-7">
      A shared vocabulary for looking closely. Start with a hair type, then explore its sub-types.
    </p>
    <p class="mt-6 max-w-2xl border-l-4 border-orange pl-4 text-sm leading-6">{classificationSystems[0].description}</p>
  </section>
  <section class="mx-auto max-w-7xl px-5 pb-10 sm:px-8">
    <div class="grid gap-3 sm:grid-cols-4">
      {hairTypes.map((hairType) => (
        <a href={`/hair-types/${hairType.slug}/`} class="hover-surface focus-ring rounded-2xl border-2 border-ink p-4">
          <span class="block text-xs font-black uppercase tracking-[.16em] text-orange">Hair type</span>
          <span class="mt-3 block font-display text-2xl">Type {hairType.code}</span>
          <span class="mt-1 block text-sm">{hairType.name}</span>
        </a>
      ))}
    </div>
  </section>
  <section class="mx-auto grid max-w-7xl gap-5 px-5 pb-20 sm:px-8 md:grid-cols-2">
    {hairSubtypes.map((type) => (
      <a
        href={`/hair-types/${type.slug}/`}
        class="hover-surface focus-ring group grid min-h-64 grid-cols-[minmax(0,1fr)_7rem] gap-4 rounded-[2rem] border-2 border-ink p-6 transition"
      >
        <div>
          <p class="text-xs font-black uppercase tracking-[.16em] text-orange">{type.pattern}</p>
          <h2 class="mt-12 font-display text-5xl tracking-[-.06em] group-hover:underline">Type {type.code}</h2>
          <p class="mt-2 max-w-sm font-display text-xl leading-tight">{type.name}</p>
          <p class="mt-2 max-w-sm text-sm leading-5">{type.description}</p>
        </div>
        <div class="self-start">
          <Pattern pattern={type.pattern} subtype={type.subtypeCode} />
        </div>
      </a>
    ))}
  </section>
</Layout>
