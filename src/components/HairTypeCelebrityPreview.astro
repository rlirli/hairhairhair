---
import { getImage } from "astro:assets";
import PersonDirectoryCard from "./PersonDirectoryCard";
import { resolvedHairTypeForNaturalProfile } from "../data/natural-profiles";
import type { HairTypePerson } from "../data/hair-type-discovery";

const { moreHref, people } = Astro.props as { moreHref: string; people: HairTypePerson[] };

const displayValue = (value: string | null, labels: Record<string, string>) =>
  value ? (labels[value] ?? value) : null;

const celebrityCards = await Promise.all(
  people.map(async ({ person, photo, naturalProfile: profile, subtype }) => {
    const resolvedType = resolvedHairTypeForNaturalProfile(profile);

    const image = photo
      ? await getImage({
          src: photo.src,
          widths: [180, 360],
          sizes: "(min-width: 1024px) 14vw, 128px",
          format: "webp",
        })
      : undefined;

    const profileValues = {
      hair: [profile?.hairTypeId.value, profile?.hairSubtypeId.value].filter((value): value is string =>
        Boolean(value),
      ),
      color: profile?.naturalHairColor.value ?? "",
      skin: profile?.naturalSkinTone.value ?? "",
    };

    const profileRows = profile
      ? [
          resolvedType && {
            label: "Hair type",
            value: `Type ${resolvedType.code} · ${resolvedType.name}`,
            href: `/hair-types/${resolvedType.slug}/`,
          },
          profile.naturalHairColor.value && {
            label: "Hair color",
            value: displayValue(profile.naturalHairColor.value, {
              black: "Black",
              brown: "Brown",
              blonde: "Blonde",
              red: "Red",
              gray: "Gray",
              white: "White",
            })!,
          },
          profile.naturalSkinTone.value && {
            label: "Skin tone",
            value: displayValue(profile.naturalSkinTone.value, {
              "deep-brown": "Deep brown",
              brown: "Brown",
              medium: "Medium",
              light: "Light",
              fair: "Fair",
            })!,
          },
          profile.hairThickness.value && {
            label: "Hair thickness",
            value: displayValue(profile.hairThickness.value, { fine: "Fine", medium: "Medium", coarse: "Coarse" })!,
          },
          profile.hairDensity.value && {
            label: "Hair density",
            value: displayValue(profile.hairDensity.value, { low: "Low", medium: "Medium", high: "High" })!,
          },
        ].filter((row): row is NonNullable<typeof row> => Boolean(row))
      : [];

    return {
      subtitle: subtype ? `Type ${subtype.code}` : undefined,
      person: {
        href: `/people/${person.slug}/`,
        name: person.name,
        imageSrc: image?.src,
        imageSrcSet: image?.srcSet.attribute,
        imageSizes: image?.attributes.sizes,
        imageAlt: photo?.alt,
        profileValues,
        description: person.description,
        profileRows,
      },
    };
  }),
);
---

<section
  class="mx-auto max-w-7xl px-5 pb-16 sm:px-8"
  aria-label="People with this natural hair type"
  data-testid="hair-type-celebrity-preview"
>
  <div class="flex items-baseline justify-between gap-4 border-b border-taupe pb-3 sm:pb-2">
    <h2 class="text-xs font-black uppercase tracking-[.16em] text-orange">Celebs with this hair type</h2>
    <a
      class="focus-ring text-xs font-normal uppercase tracking-[.12em] text-muted transition hover:text-ink"
      href={moreHref}
    >
      More
    </a>
  </div>
  <div class="mt-2.5 sm:mt-4 grid grid-flow-col auto-cols-[minmax(8rem,1fr)] gap-3 overflow-x-auto pb-3 lg:grid-flow-row lg:grid-cols-7 lg:auto-cols-auto lg:overflow-visible">
    {celebrityCards.map(({ person, subtitle }) => (
      <PersonDirectoryCard client:load person={person} subtitle={subtitle} />
    ))}
  </div>
</section>
