---
import { Image } from "astro:assets";
import Layout from "../../../../components/Layout.astro";
import { buildPersonMedia } from "../../../../data/people-media";
import { appearances, people, personPhotographs } from "../../../../data/people";
import { observedStylesForAppearance } from "../../../../data/people-relations";

export function getStaticPaths() {
  const media = buildPersonMedia(personPhotographs);
  return people.flatMap((person) =>
    media
      .filter((photo) =>
        appearances.some((appearance) => appearance.personId === person.id && appearance.imageId === photo.id),
      )
      .map((photo) => ({
        params: { slug: person.slug, photoId: photo.id },
        props: { person, photo },
      })),
  );
}

const { person, photo } = Astro.props;
const photoAppearances = appearances
  .filter((appearance) => appearance.personId === person.id && appearance.imageId === photo.id)
  .sort((a, b) => b.taken.value.localeCompare(a.taken.value));
const appearanceTitle = (event: string) => event.split(",")[0];
const formatDate = (value: string) =>
  new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric" }).format(
    new Date(`${value}T00:00:00`),
  );
const photoStyles = photoAppearances.flatMap((appearance) =>
  observedStylesForAppearance(appearance.id).map(({ style }) => style),
);
const uniqueStyles = photoStyles.filter(
  (style, index) => photoStyles.findIndex((item) => item.id === style.id) === index,
);
---

<Layout
  title={`${photo.identifier} photograph — ${person.name} — hairhairhair.hair`}
  description={`Source and usage record for a public-domain photograph of ${person.name}.`}
  image={photo.src.src}
>
  <article class="mx-auto max-w-5xl px-5 pb-20 pt-12 sm:px-8">
    <nav aria-label="Breadcrumb" class="text-sm font-bold uppercase tracking-[.12em]">
      <a class="focus-ring text-orange" href="/">
        Home
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <a class="focus-ring text-orange" href="/people/">
        People
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <a class="focus-ring text-orange" href={`/people/${person.slug}/`}>
        {person.name}
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <span>Photograph</span>
    </nav>

    <header class="mt-12 max-w-3xl">
      <p class="text-xs font-black uppercase tracking-[.18em] text-orange">Photograph record</p>
      <h1 class="mt-4 font-display text-6xl leading-[.88] tracking-[-.08em] sm:text-8xl">{photo.identifier}</h1>
      <p class="mt-6 text-lg leading-7">A source and usage record for this image of {person.name}.</p>
    </header>

    <figure class="mt-12">
      <Image
        src={photo.src}
        widths={[600, 1000, 1400]}
        sizes="(min-width: 1024px) 70vw, 100vw"
        format="webp"
        alt={photo.alt}
        class="max-h-[75vh] w-full rounded-[2rem] object-contain"
      />
      <figcaption class="mt-5 border-l-4 border-orange pl-4 text-sm leading-6">
        <p class="font-bold">{photo.creator}</p>
        <p>{photo.rightsBasis}</p>
        <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
          <a
            class="focus-ring text-orange underline decoration-orange decoration-2 underline-offset-4"
            href={photo.sourceUrl}
            target="_blank"
            rel="noreferrer"
          >
            Source record ↗
          </a>
          <a
            class="focus-ring text-orange underline decoration-orange decoration-2 underline-offset-4"
            href={photo.originalUrl}
            target="_blank"
            rel="noreferrer"
          >
            Original file ↗
          </a>
          <a
            class="focus-ring text-orange underline decoration-orange decoration-2 underline-offset-4"
            href={photo.rightsEvidenceUrl}
            target="_blank"
            rel="noreferrer"
          >
            Rights evidence ↗
          </a>
        </p>
        <p class="mt-2 opacity-70">
          Identifier: {photo.identifier} · {photo.jurisdiction} public-domain basis
        </p>
      </figcaption>
    </figure>

    <section class="mt-16" aria-labelledby="used-in-heading">
      <div class="border-b border-ink pb-3">
        <h2 id="used-in-heading" class="text-xs font-black uppercase tracking-[.18em] text-orange">
          Used in
        </h2>
      </div>
      <div class="mt-7 grid gap-8 md:grid-cols-2">
        <div>
          <h3 class="font-display text-3xl tracking-[-.03em]">Appearances</h3>
          <ul class="mt-4 space-y-3 text-sm leading-6">
            {photoAppearances.map((appearance) => (
              <li>
                <a
                  class="focus-ring font-bold text-orange underline decoration-orange decoration-2 underline-offset-4"
                  href={`/people/${person.slug}/appearances/${appearance.id}/`}
                >
                  {formatDate(appearance.taken.value)} · {appearanceTitle(appearance.event)} ↗
                </a>
                <p class="mt-1">{appearance.event}</p>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="font-display text-3xl tracking-[-.03em]">Related guides</h3>
          {uniqueStyles.length ? (
            <ul class="mt-4 space-y-3 text-sm leading-6">
              {uniqueStyles.map((style) => (
                <li>
                  <a
                    class="focus-ring font-bold text-orange underline decoration-orange decoration-2 underline-offset-4"
                    href={`/hairstyles/${style.slug}/`}
                  >
                    {style.name} guide ↗
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-4 text-sm leading-6">No hairstyle guide is linked to this photograph yet.</p>
          )}
        </div>
      </div>
    </section>

    <a
      class="focus-ring mt-14 inline-block font-bold text-orange underline decoration-orange decoration-2 underline-offset-4"
      href={`/people/${person.slug}/`}
    >
      ← Back to {person.name}
    </a>
  </article>
</Layout>
