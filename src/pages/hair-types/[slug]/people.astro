---
import Layout from "../../../components/shared/Layout.astro";
import PersonFactSheet from "../../../components/people/PersonFactSheet.astro";
import { Image } from "astro:assets";
import { hairSubtypes, hairTypes } from "../../../data/hair-types";
import { peopleForHairTypeSlug } from "../../../data/hair-type-discovery";

export function getStaticPaths() {
  return [...hairTypes, ...hairSubtypes].map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
const people = peopleForHairTypeSlug(item.slug);
---

<Layout
  title={`People with Type ${item.code} hair - hairhairhair.hair`}
  description={`People with a documented natural profile matching Type ${item.code} ${item.name} hair.`}
>
  <main class="mx-auto max-w-7xl px-5 pb-16 pt-8 sm:px-8">
    <a class="focus-ring text-xs font-bold uppercase tracking-[.12em] text-orange" href={`/hair-types/${item.slug}/`}>
      Type {item.code}
    </a>
    <header class="mt-6 border-b border-ink pb-7">
      <p class="text-xs font-black uppercase tracking-[.18em] text-orange">Celebrity inspiration</p>
      <h1 class="mt-2 font-display text-5xl leading-tight tracking-[-.07em] sm:text-7xl">
        People with Type {item.code} {item.name}
      </h1>
    </header>
    {people.length > 0 ? (
      <ul class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {people.map(({ person, photo, naturalProfile, subtype }) => (
          <li class="rounded-3xl border border-ink/25 p-4">
            <a class="focus-ring block" href={`/people/${person.slug}/`}>
              <Image
                src={photo.src}
                alt={photo.alt}
                width={480}
                height={480}
                class="aspect-[4/5] w-full object-cover"
              />
              <h2 class="mt-3 font-display text-2xl">{person.name}</h2>
              {subtype && <p class="text-sm opacity-70">Type {subtype.code}</p>}
            </a>
            <div class="mt-4">
              <PersonFactSheet profile={naturalProfile} />
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-8">No people have a matching natural profile yet.</p>
    )}
  </main>
</Layout>
