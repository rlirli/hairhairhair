---
import Layout from "../../components/Layout.astro";
import HairstyleCard from "../../components/HairstyleCard.astro";
import { hairSubtypes, hairTypes } from "../../data/hair-types";
import { publishedHairstyles } from "../../data/hairstyles";
import { compatibleHairstylesForHairType } from "../../data/hairstyle-compatibility";
import { kindLabels } from "../../data/hairstyle-relations";

const kinds = Object.entries(kindLabels).map(([id, label]) => ({ id, label }));
const hairTypeOptions = [
  ...hairTypes.map((type) => ({ id: type.id, label: `Type ${type.code}` })),
  ...hairSubtypes.map((type) => ({ id: type.id, label: `Type ${type.code}` })),
];
const compatibleStylesByType = new Map(
  hairTypeOptions.map(
    (type) => [type.id, new Set(compatibleHairstylesForHairType(type.id).map((style) => style.id))] as const,
  ),
);
const hairTypeIdsForStyle = (styleId: string) =>
  hairTypeOptions.filter((type) => compatibleStylesByType.get(type.id)?.has(styleId)).map((type) => type.id);
const filterGroups = [
  { key: "kind", label: "Kind", options: kinds },
  { key: "hair-type", label: "Hair type", options: hairTypeOptions },
];
---

<Layout
  title="Hairstyles — hairhairhair.hair"
  description="Research-backed hairstyle profiles for naming a look and preparing for a consultation."
>
  <section class="mx-auto max-w-7xl px-5 pb-14 pt-14 sm:px-8">
    <p class="text-xs font-black uppercase tracking-[.2em] text-orange">The hairstyle collection</p>
    <h1 class="mt-3 max-w-4xl font-display text-6xl leading-[.88] tracking-[-.08em] sm:text-8xl">
      Name the look.
      <br />
      <span class="text-orange">Plan the conversation.</span>
    </h1>
    <p class="mt-8 max-w-2xl text-lg leading-7">
      Explore cuts, finishing techniques, and ways of arranging hair. Use them to find precise words before you sit in
      the chair.
    </p>
    <div class="mt-10 border-b border-ink/30 pb-1.5 pr-1.5">
      <div class="flex justify-end gap-3 text-xs font-normal text-ink/60 sm:gap-5" data-hairstyle-filters>
        {filterGroups.map((group) => (
          <details class="relative" data-hairstyle-filter={group.key}>
            <summary class="focus-ring flex cursor-pointer list-none items-center gap-1 whitespace-nowrap uppercase">
              <span data-filter-label data-default-label={group.label}>
                {group.label}
              </span>
              <span aria-hidden="true" class="relative -top-0.75">
                ⌄
              </span>
            </summary>
            <fieldset class="absolute right-0 top-full z-30 mt-2 max-h-64 w-56 overflow-auto rounded-xl border border-ink/20 bg-ivory p-3 shadow-lg">
              <legend class="sr-only">{group.label}</legend>
              <div class="grid gap-2">
                {group.options.map((option) => (
                  <label class="flex cursor-pointer items-center gap-2 text-sm font-normal text-ink/60">
                    <input class="accent-orange" type="checkbox" value={option.id} />
                    <span>{option.label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          </details>
        ))}
      </div>
    </div>
  </section>
  <p class="sr-only" data-hairstyle-results role="status" aria-live="polite"></p>
  <section
    class="mx-auto grid max-w-7xl grid-cols-2 gap-5 px-5 pb-20 sm:px-8 md:grid-cols-3 lg:grid-cols-4"
    data-hairstyle-grid
  >
    {publishedHairstyles.map((style) => (
      <HairstyleCard style={style} filterable compatibleHairTypeIds={hairTypeIdsForStyle(style.id)} />
    ))}
    <p class="col-span-full mt-4 hidden text-sm text-ink/60" data-hairstyle-empty>
      No hairstyles match these filters.
    </p>
  </section>
</Layout>

<script>
  const filters = [...document.querySelectorAll<HTMLDetailsElement>("[data-hairstyle-filter]")];
  const cards = [...document.querySelectorAll<HTMLElement>("[data-hairstyle-card]")];
  const results = document.querySelector<HTMLElement>("[data-hairstyle-results]");
  const empty = document.querySelector<HTMLElement>("[data-hairstyle-empty]");

  const update = () => {
    let visible = 0;
    for (const filter of filters) {
      const selected = [...filter.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')];
      const label = filter.querySelector<HTMLElement>("[data-filter-label]");
      if (label) {
        const fallback = label.dataset.defaultLabel ?? "";
        label.textContent =
          selected.length === 1 ? (selected[0].nextElementSibling?.textContent?.trim() ?? fallback) : fallback;
      }
    }
    for (const card of cards) {
      const matches = filters.every((filter) => {
        const dimension = filter.dataset.hairstyleFilter;
        const selected = [...filter.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')].map(
          (input) => input.value,
        );
        if (selected.length === 0 || !dimension) return true;
        const values =
          dimension === "kind"
            ? [card.dataset.hairstyleKind ?? ""]
            : (card.dataset.hairstyleHairTypes ?? "").split(",");
        return selected.some((value) => values.includes(value));
      });
      card.classList.toggle("hidden", !matches);
      if (matches) visible += 1;
    }
    if (results) results.textContent = `${visible} ${visible === 1 ? "hairstyle" : "hairstyles"} shown`;
    if (empty) empty.classList.toggle("hidden", visible !== 0);
  };

  for (const filter of filters) filter.addEventListener("change", update);
  document.addEventListener("click", (event) => {
    for (const filter of filters) {
      if (event.target instanceof Node && !filter.contains(event.target)) filter.open = false;
    }
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    for (const filter of filters) {
      if (!filter.open) continue;
      filter.open = false;
      filter.querySelector("summary")?.focus();
    }
  });
  update();
</script>
