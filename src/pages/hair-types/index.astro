---
import Layout from '../../components/Layout.astro';
import Pattern from '../../components/Pattern.astro';
import { hairTypes, classificationSystems } from '../../data/hair-types';
---
<Layout title="Hair types — hairhairhair.hair" description="Browse the complete hair type field guide.">
  <section class="mx-auto max-w-7xl px-5 pb-12 pt-14 sm:px-8"><p class="text-xs font-black uppercase tracking-[.2em] text-orange">The field guide</p><h1 class="mt-3 max-w-3xl font-display text-6xl leading-[.9] tracking-[-.08em] sm:text-8xl">Find your<br /><span class="text-orange">pattern.</span></h1><p class="mt-8 max-w-xl text-lg leading-7">A shared vocabulary for looking closely. Start with a family, then follow the details.</p><p class="mt-6 max-w-2xl border-l-4 border-orange pl-4 text-sm leading-6">{classificationSystems[0].description}</p></section>
  <section class="mx-auto grid max-w-7xl gap-5 px-5 pb-20 sm:px-8 md:grid-cols-2">{hairTypes.map((type, i) => <a href={`/hair-types/${type.slug}/`} class="focus-ring group grid min-h-64 grid-cols-[1fr_8rem] gap-4 rounded-[2rem] border-2 border-ink p-6 transition hover:-translate-y-1 hover:bg-butter"><div><p class="text-xs font-black uppercase tracking-[.16em] text-orange">{String(i + 1).padStart(2, '0')} / {type.code}</p><h2 class="mt-12 font-display text-4xl tracking-[-.06em] group-hover:underline">{type.name}</h2><p class="mt-2 max-w-sm text-sm leading-5">{type.description}</p></div><div class="self-start"><Pattern family={type.family} subtype={type.subtype} /></div></a>)}</section>
</Layout>
