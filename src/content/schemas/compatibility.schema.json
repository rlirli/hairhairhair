{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hairhairhair.hair/schemas/compatibility.schema.json",
  "title": "Hairstyle compatibility assessments",
  "type": "object",
  "required": ["hairstyleId", "assessments"],
  "properties": {
    "hairstyleId": { "type": "string" },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criteria", "score", "provenance"],
        "properties": {
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["dimension", "valueId"],
              "properties": {
                "dimension": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "valueId": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "provenance": { "const": "estimated" },
          "variationId": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
