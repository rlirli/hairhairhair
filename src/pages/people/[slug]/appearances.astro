---
import { Image } from "astro:assets";
import Layout from "../../../components/shared/Layout.astro";
import { getAppearancesForPerson } from "../../../data/people-relations";
import { people, personPhotographs } from "../../../data/people";
import PhotoAttribution from "../../../components/shared/PhotoAttribution";
import { appearanceTitle } from "../../../lib/appearance-formatting";

export function getStaticPaths() {
  return people.map((person) => ({ params: { slug: person.slug }, props: { person } }));
}

const { person } = Astro.props;
const media = personPhotographs;
const appearances = getAppearancesForPerson(person.id)
  .flatMap((appearance) => {
    const photo = media.find((photo) => photo.id === appearance.imageId);
    return photo ? [{ appearance, photo }] : [];
  })
  .sort((a, b) => b.appearance.taken.value.localeCompare(a.appearance.taken.value));
---

<Layout
  title={`${person.name} appearances - people - hairhairhair.hair`}
  description={`A chronological overview of ${person.name}'s documented public appearances and hairstyles.`}
>
  <article class="mx-auto max-w-7xl px-5 pb-20 pt-12 sm:px-8">
    <nav
      aria-label="Breadcrumb"
      class="mb-8 flex flex-wrap items-center gap-y-1 text-xs font-bold uppercase tracking-[.12em] sm:text-sm"
    >
      <a class="focus-ring text-orange" href="/">
        Home
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <a class="focus-ring text-orange" href="/people/">
        People
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <a class="focus-ring text-orange" href={`/people/${person.slug}/`}>
        {person.name}
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <span>Appearances</span>
    </nav>

    <header class="mt-12 max-w-3xl">
      <p class="text-xs font-black uppercase tracking-[.18em] text-orange">Appearance archive</p>
      <h1 class="mt-4 font-display text-6xl leading-[.88] tracking-[-.08em] sm:text-8xl">
        {person.name}
        <br />
        <span class="text-orange">in public.</span>
      </h1>
      <p class="mt-7 text-lg leading-7">
        A chronological visual record of documented appearances. Each entry points back to the source photograph and the
        hairstyle observations recorded for that moment.
      </p>
    </header>

    <section class="mt-16" aria-labelledby="appearances-heading">
      <div class="border-b border-taupe pb-3 sm:pb-2">
        <p class="text-xs font-black uppercase tracking-[.18em] text-orange">Person record</p>
        <h2 id="appearances-heading" class="mt-2 font-display text-4xl tracking-[-.04em]">
          Appearances
        </h2>
      </div>

      <ul class="mt-2.5 sm:mt-4 grid gap-x-4 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
        {appearances.map(({ appearance, photo }) => (
          <li class="group" id={appearance.id}>
            <figure>
              <div class="relative overflow-hidden">
                <a
                  class="group focus-ring block"
                  href={`/people/${person.slug}/appearances/${appearance.id}/`}
                  aria-label={`${appearance.taken.value}: ${appearance.event}`}
                >
                  <Image
                    src={photo.image}
                    widths={[400, 700, 1000]}
                    sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                    format="webp"
                    alt={photo.alt}
                    class="aspect-[4/5] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                    style={`object-position: ${photo.objectPosition}`}
                  />
                </a>
                <PhotoAttribution provenance={photo.provenance} density="compact" />
              </div>
              <figcaption class="mt-2">
                <h3 class="font-display text-lg leading-tight tracking-[-.02em]">
                  <a class="focus-ring" href={`/people/${person.slug}/appearances/${appearance.id}/`}>
                    {appearanceTitle(appearance.event)}
                  </a>
                </h3>
                <p class="mt-1 text-xs leading-tight text-muted">{appearance.taken.value}</p>
                <p class="mt-1.5 text-sm leading-5">{appearance.event}</p>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>

    <p class="mt-16 max-w-3xl border-l-4 border-orange pl-4 text-sm leading-6">
      This is an overview, not a complete career timeline. The archive currently includes only appearances with a
      source-verified photograph suitable for hairstyle reference.
    </p>
  </article>
</Layout>
