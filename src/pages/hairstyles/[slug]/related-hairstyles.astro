---
import Layout from "../../../components/shared/Layout.astro";
import HairstyleGridData from "../../../components/hairstyles/HairstyleGridData.astro";
import { publishedHairstyles } from "../../../data";
import { getPublishedHairstylesByIds } from "../../../data";

export function getStaticPaths() {
  return publishedHairstyles.map((style) => ({ params: { slug: style.slug }, props: { style } }));
}

const { style } = Astro.props;
const related = getPublishedHairstylesByIds(style.relatedStyleIds);
---

<Layout
  title={`${style.name} related hairstyles - hairhairhair.hair`}
  description={`Hairstyles related to ${style.name}.`}
>
  <main class="mx-auto max-w-7xl px-5 pb-20 pt-12 sm:px-8">
    <nav aria-label="Breadcrumb" class="text-sm font-bold uppercase tracking-[.12em]">
      <a class="focus-ring text-orange" href="/hairstyles/">
        Hairstyles
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <a class="focus-ring text-orange" href={`/hairstyles/${style.slug}/`}>
        {style.name}
      </a>
      <span class="mx-2" aria-hidden="true">
        /
      </span>
      <span>Related hairstyles</span>
    </nav>
    <header class="mt-10 border-b border-taupe pb-3 sm:pb-2">
      <h1 class="font-display text-5xl tracking-[-.07em] sm:text-7xl">{style.name} related hairstyles</h1>
    </header>
    {related.length ? (
      <HairstyleGridData
        styles={related}
        size="small"
        className="mt-2.5 sm:mt-4 grid grid-cols-2 gap-x-3 gap-y-5 sm:grid-cols-3 lg:grid-cols-6"
      />
    ) : (
      <p class="mt-10 rounded-2xl border-2 border-ink p-6">No related hairstyles are currently listed.</p>
    )}
  </main>
</Layout>
