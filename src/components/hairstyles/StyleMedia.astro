---
import { Image } from "astro:assets";
import { getMedia } from "../../data/media";
interface Props {
  mediaId: string;
  title?: string;
  caption?: string;
  patternDescription?: string;
  lengthDescription?: string;
  eager?: boolean;
}
const { mediaId, title, caption, patternDescription, lengthDescription, eager = false } = Astro.props;
const media = getMedia(mediaId);
---

{media && (
  <figure>
    <Image
      src={media.image}
      widths={[400, 800, 1120]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      format="webp"
      alt={media.alt}
      loading={eager ? "eager" : "lazy"}
      class="w-full rounded-[2rem] object-cover bg-hairstyle-image-bg"
    />
    {(title || caption || patternDescription || lengthDescription || media.provenance.licenseType === "licensed") && (
      <figcaption class="mt-3 text-sm leading-6">
        {media.provenance.licenseType === "licensed" && (
          <>
            <span class="font-bold">
              {media.provenance.creator || media.provenance.attribution || "Photographic reference"}
            </span>
            {media.provenance.sourceUrl && (
              <>
                {" "}
                ·{" "}
                <a class="underline" href={media.provenance.sourceUrl} target="_blank" rel="noreferrer">
                  Source
                </a>
              </>
            )}
            {media.provenance.licenseUrl && (
              <>
                {" "}
                ·{" "}
                <a class="underline" href={media.provenance.licenseUrl} target="_blank" rel="noreferrer">
                  {media.provenance.licenseName || "License"}
                </a>
              </>
            )}
          </>
        )}
        {title && (
          <>
            {media.provenance.licenseType === "licensed" && <> · </>}
            {title}
          </>
        )}
        {caption && (
          <>
            {title || media.provenance.licenseType === "licensed" ? " · " : ""}
            {caption}
          </>
        )}
        {patternDescription && <span class="mt-1 block">{patternDescription}</span>}
        {lengthDescription && <span class="mt-1 block">{lengthDescription}</span>}
      </figcaption>
    )}
  </figure>
)}
